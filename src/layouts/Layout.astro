---
import '../styles/global.css';
import ScrollToTop from '../components/ScrollToTop.astro';
import CompareFloatingBar from '../components/CompareFloatingBar.astro';
import InstallFloatingBar from '../components/InstallFloatingBar.astro';
import FavoritesManager from '../components/FavoritesManager.astro';
import PreferencesManager from '../components/PreferencesManager.astro';
import EthicalAd from '../components/EthicalAd.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { resolveEthicalAdsPublisher } from '../utils/ethicalAds';
import { resolveGaMeasurementId, resolveGscVerification } from '../utils/analytics';
import { buildBreadcrumbSchema, type BreadcrumbItem } from '../utils/seoSchema';
import { SEO } from 'astro-seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  articleDate?: string;
  articleModifiedDate?: string;
  articleAuthor?: string;
  articleKeywords?: readonly string[];
  articleWordCount?: number;
  schema?: Record<string, unknown> | readonly Record<string, unknown>[];
  breadcrumbs?: readonly BreadcrumbItem[];
  markdownUrl?: string;
  canonicalURL?: string | URL;
  /** Page topics for EthicalAds contextual targeting. */
  adKeywords?: readonly (string | undefined | null)[];
  /** Set false to render the page without the floating ad. */
  showAd?: boolean;
  /** Set true to add robots noindex meta tag (e.g., auth/settings pages). */
  noindex?: boolean;
}

const {
  title,
  description = 'Discover, search, and track modern and AI-ready JMeter plugins. Community-driven directory automatically synced daily.',
  image = '/og/home.png',
  type = 'website',
  articleDate,
  articleModifiedDate,
  articleAuthor,
  articleKeywords,
  articleWordCount,
  schema,
  breadcrumbs,
  markdownUrl,
  canonicalURL,
  adKeywords = [],
  showAd = true,
  noindex = false,
} = Astro.props;

const adPublisher = showAd
  ? resolveEthicalAdsPublisher(import.meta.env.PUBLIC_ETHICALADS_PUBLISHER)
  : null;
const gaMeasurementId = resolveGaMeasurementId(import.meta.env.PUBLIC_GA_MEASUREMENT_ID);
const gscVerification = resolveGscVerification(import.meta.env.PUBLIC_GSC_VERIFICATION);

// Determine canonical URL: fallback to current pathname.
// Keep trailing slashes as-is — Astro static output serves pages via
// directory/index.html, so the canonical must match the trailing-slash form
// that browsers and crawlers actually receive.
const resolvedCanonicalURL = canonicalURL
  ? typeof canonicalURL === 'string'
    ? canonicalURL
    : canonicalURL.toString()
  : new URL(Astro.url.pathname, Astro.site || 'https://plugins.jmeter.ai').toString();
const socialImageURL = new URL(image, Astro.site || 'https://plugins.jmeter.ai');

// Best-effort MIME hint so crawlers can pick the image without HEAD-probing.
const socialImageType = /\.png($|\?)/i.test(socialImageURL.pathname)
  ? 'image/png'
  : /\.jpe?g($|\?)/i.test(socialImageURL.pathname)
    ? 'image/jpeg'
    : /\.webp($|\?)/i.test(socialImageURL.pathname)
      ? 'image/webp'
      : /\.svg($|\?)/i.test(socialImageURL.pathname)
        ? 'image/svg+xml'
        : undefined;
const isGeneratedOg =
  socialImageURL.pathname.startsWith('/og/') && socialImageURL.pathname.endsWith('.png');

// --- Global JSON-LD schemas ---

// Organization schema: establishes entity authority for AI agents
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PerfAtlas by QAInsights',
  url: 'https://plugins.jmeter.ai',
  logo: {
    '@type': 'ImageObject',
    url: 'https://plugins.jmeter.ai/android-chrome-512x512.png',
    width: 512,
    height: 512,
  },
  sameAs: [
    'https://github.com/QAInsights/plugins.jmeter.ai',
    'https://qainsights.com',
    'https://twitter.com/qainsights',
  ],
  founder: {
    '@type': 'Person',
    name: 'NaveenKumar Namachivayam',
    url: 'https://qainsights.com',
    sameAs: ['https://twitter.com/qainsights', 'https://github.com/QAInsights'],
  },
};

// WebSite schema with SearchAction — tells agents how to search the site
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PerfAtlas — JMeter Plugin Directory',
  url: 'https://plugins.jmeter.ai',
  description:
    'The modern directory for JMeter plugins — search, discover, compare, and track the velocity of load testing extensions, with AI-ready plugin highlights.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://plugins.jmeter.ai/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

// Article schema for blog posts
const articleSchema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: description,
        image: socialImageURL.toString(),
        url: resolvedCanonicalURL,
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': resolvedCanonicalURL,
        },
        ...(articleDate ? { datePublished: articleDate } : {}),
        ...(articleModifiedDate
          ? { dateModified: articleModifiedDate }
          : articleDate
            ? { dateModified: articleDate }
            : {}),
        ...(articleKeywords && articleKeywords.length > 0
          ? { keywords: articleKeywords.join(', ') }
          : {}),
        ...(articleWordCount ? { wordCount: articleWordCount } : {}),
        author: {
          '@type': 'Person',
          name: articleAuthor || 'NaveenKumar Namachivayam',
          url: 'https://qainsights.com',
          sameAs: ['https://twitter.com/qainsights', 'https://github.com/QAInsights'],
        },
        publisher: {
          '@type': 'Organization',
          name: 'PerfAtlas by QAInsights',
          url: 'https://plugins.jmeter.ai',
          logo: {
            '@type': 'ImageObject',
            url: 'https://plugins.jmeter.ai/android-chrome-512x512.png',
            width: 512,
            height: 512,
          },
        },
      }
    : null;
const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0 ? buildBreadcrumbSchema(breadcrumbs) : null;
const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const safeJsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Machine-readable site description for AI agents and LLMs */}
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="LLM-readable site description"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      href="/rss.xml"
      title="PerfAtlas Blog RSS Feed"
    />
    {
      markdownUrl && (
        <link rel="alternate" type="text/markdown" href={markdownUrl} title="Markdown version" />
      )
    }
    <meta name="theme-color" content="#09090b" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      canonical={resolvedCanonicalURL}
      noindex={noindex}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: socialImageURL.toString(),
          url: resolvedCanonicalURL,
        },
        optional: {
          description: description,
          locale: 'en_US',
          siteName: 'PerfAtlas',
        },
        article:
          type === 'article'
            ? {
                publishedTime: articleDate,
                modifiedTime: articleModifiedDate || articleDate,
                authors: [articleAuthor || 'NaveenKumar Namachivayam'],
              }
            : undefined,
      }}
      twitter={{
        creator: '@qainsights',
        card: 'summary_large_image',
        title: title,
        description: description,
        image: socialImageURL.toString(),
      }}
      extend={{
        meta: [
          { name: 'twitter:url', content: resolvedCanonicalURL },
          ...(isGeneratedOg
            ? [
                { property: 'og:image:width', content: '1200' },
                { property: 'og:image:height', content: '630' },
                { property: 'og:image:alt', content: title },
              ]
            : []),
          ...(socialImageType ? [{ property: 'og:image:type', content: socialImageType }] : []),
        ],
      }}
    />

    <script is:inline>
      (function () {
        var theme = 'system';
        try {
          var prefs = JSON.parse(localStorage.getItem('perfatlas:prefs') || 'null');
          if (prefs && typeof prefs.theme === 'string') {
            theme = prefs.theme;
          } else if (localStorage.getItem('theme')) {
            // Legacy key written by the old header toggle; migrated on first run.
            theme = localStorage.getItem('theme');
          }
        } catch (_) {}
        var dark =
          theme === 'dark' ||
          (theme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    {/* Global Organization schema on every page */}
    <script type="application/ld+json" set:html={safeJsonLd(organizationSchema)} />
    {/* Global WebSite schema with SearchAction on every page */}
    <script type="application/ld+json" set:html={safeJsonLd(websiteSchema)} />
    {/* Article schema for blog posts */}
    {articleSchema && <script type="application/ld+json" set:html={safeJsonLd(articleSchema)} />}
    {/* BreadcrumbList schema */}
    {
      breadcrumbSchema && (
        <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />
      )
    }
    {/* Page-specific schema(s) (SoftwareApplication, FAQPage, ItemList, etc.) */}
    {extraSchemas.map((item) => <script type="application/ld+json" set:html={safeJsonLd(item)} />)}

    {/* Cloudflare Web Analytics */}
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "18dd9054c9194403bcc8517c16fa73ad"}'></script>

    {/* Optional Google Analytics 4 + AI referral & key event tracking */}
    {gaMeasurementId && <GoogleAnalytics measurementId={gaMeasurementId} />}
  </head>
  <body
    class="selection:bg-primary selection:text-dark-bg flex min-h-screen flex-col font-sans antialiased dark:selection:bg-[#ccff00]"
  >
    <slot />
    <ScrollToTop />
    <CompareFloatingBar />
    <InstallFloatingBar />
    <FavoritesManager />
    <PreferencesManager />
    {adPublisher && <EthicalAd publisher={adPublisher} keywords={adKeywords} />}
  </body>
</html>
