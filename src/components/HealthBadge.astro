---
import type { HealthInfo } from '../utils/health';

interface Props {
  health?: HealthInfo;
  size?: 'sm' | 'md';
  compact?: boolean;
}

const { health, size = 'sm', compact = false } = Astro.props;

const shouldRender = health && health.label !== 'Unknown';

const label = health?.label;
const score = health?.score;

// Single-letter code for compact mode
const letter = label === 'Active' ? 'A' : label === 'Maintained' ? 'M' : label === 'Stale' ? 'S' : label === 'Archived' ? 'R' : '';

// Determine colors based on health label
let colorClasses = '';
if (label === 'Active') {
  colorClasses =
    'text-green-700 bg-green-50 border-green-200/60 dark:text-green-400 dark:bg-green-500/10 dark:border-green-500/20';
} else if (label === 'Maintained') {
  colorClasses =
    'text-blue-700 bg-blue-50 border-blue-200/60 dark:text-blue-400 dark:bg-blue-500/10 dark:border-blue-500/20';
} else if (label === 'Stale') {
  colorClasses =
    'text-amber-700 bg-amber-50 border-amber-200/60 dark:text-amber-400 dark:bg-amber-500/10 dark:border-amber-500/20';
} else if (label === 'Archived') {
  colorClasses =
    'text-rose-700 bg-rose-50 border-rose-200/60 dark:text-rose-400 dark:bg-rose-500/10 dark:border-rose-500/20';
}

const sizeClasses =
  size === 'sm' ? 'px-2 py-0.5 text-[10px] font-bold' : 'px-2.5 py-1 text-xs font-bold';

function getRelativeTime(dateStr: string | null | undefined): string {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  if (isNaN(date.getTime())) return '';
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffDays <= 0) return 'updated today';
  if (diffDays === 1) return 'updated yesterday';
  if (diffDays < 30) return `updated ${diffDays} days ago`;

  const diffMonths = Math.floor(diffDays / 30.44);
  if (diffMonths === 1) return 'updated 1 month ago';
  if (diffMonths < 12) return `updated ${diffMonths} months ago`;

  const diffYears = Math.floor(diffMonths / 12);
  if (diffYears === 1) return 'updated 1 year ago';
  return `updated ${diffYears} years ago`;
}

const relativeTime = health ? getRelativeTime(health.lastCommitAt) : '';

const tooltipParts = [label, `Health Score: ${score}/100`];
if (relativeTime) tooltipParts.push(relativeTime);
const tooltip = tooltipParts.join(' · ');
---

{
  shouldRender && (
    compact ? (
      <span
        class={`inline-flex h-5 w-5 items-center justify-center rounded-md border ${colorClasses} text-[10px] font-black leading-none`}
        title={tooltip}
        aria-label={label}
      >
        {letter}
      </span>
    ) : (
      <span
        class={`inline-flex items-center gap-1.5 rounded-md border ${colorClasses} ${sizeClasses}`}
        title={`Health Score: ${score}/100`}
      >
        <span class="h-1.5 w-1.5 rounded-full bg-current" />
        <span>{label}</span>
        {relativeTime && <span class="font-normal opacity-60">&middot; {relativeTime}</span>}
      </span>
    )
  )
}
