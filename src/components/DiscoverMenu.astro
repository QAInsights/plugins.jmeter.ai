---

---

<!-- Discover mega menu -->
<div class="group relative" id="discoverMenuWrapper">
  <button
    type="button"
    aria-haspopup="true"
    class="flex items-center gap-1 font-bold text-gray-900 transition-colors hover:text-green-600 dark:text-white dark:hover:text-[#ccff00]"
  >
    Discover
    <svg
      class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"
      ></path></svg
    >
  </button>
  <!-- Mega panel -->
  <div
    class="pointer-events-none invisible absolute top-full left-1/2 w-[540px] -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 ease-out group-hover:pointer-events-auto group-hover:visible group-hover:opacity-100"
    style="z-index:999"
  >
    <div
      class="absolute top-1.5 left-1/2 h-3 w-3 -translate-x-1/2 rotate-45 rounded-sm border-t border-l border-gray-200 bg-white dark:border-white/10 dark:bg-[#1a1a1a]"
    >
    </div>
    <div
      class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-white/10 dark:bg-[#1a1a1a]"
    >
      <div class="h-1 bg-gradient-to-r from-green-500 via-green-400 to-[#ccff00]"></div>
      <div class="px-6 pt-4 pb-2">
        <p class="text-[10px] font-bold tracking-widest text-gray-400 uppercase dark:text-gray-500">
          PerfAtlas Features
        </p>
      </div>
      <div class="grid grid-cols-2 gap-1.5 px-4 pb-5">
        <a
          href="/#search"
          class="group/card flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50 dark:hover:bg-white/5"
        >
          <div
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-green-50 text-green-600 dark:bg-green-900/20 dark:text-[#ccff00]"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
            >
          </div>
          <div>
            <p
              class="text-sm font-bold text-gray-900 transition-colors group-hover/card:text-green-600 dark:text-white dark:group-hover/card:text-[#ccff00]"
            >
              Search
            </p>
            <p class="mt-0.5 text-xs leading-snug text-gray-500 dark:text-gray-400">
              Find plugins instantly by name, vendor, or category
            </p>
          </div>
        </a>
        <a
          href="/#compare"
          class="group/card flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50 dark:hover:bg-white/5"
        >
          <div
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-900/20 dark:text-blue-400"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg
            >
          </div>
          <div>
            <p
              class="text-sm font-bold text-gray-900 transition-colors group-hover/card:text-blue-600 dark:text-white dark:group-hover/card:text-blue-400"
            >
              Compare
            </p>
            <p class="mt-0.5 text-xs leading-snug text-gray-500 dark:text-gray-400">
              Side-by-side plugin comparison at a glance
            </p>
          </div>
        </a>
        <a
          href="/#statistics"
          class="group/card flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50 dark:hover:bg-white/5"
        >
          <div
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-purple-50 text-purple-600 dark:bg-purple-900/20 dark:text-purple-400"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path></svg
            >
          </div>
          <div>
            <p
              class="text-sm font-bold text-gray-900 transition-colors group-hover/card:text-purple-600 dark:text-white dark:group-hover/card:text-purple-400"
            >
              Statistics
            </p>
            <p class="mt-0.5 text-xs leading-snug text-gray-500 dark:text-gray-400">
              Download trends and usage insights
            </p>
          </div>
        </a>
        <a
          href="/#ai-ready"
          class="group/card flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50 dark:hover:bg-white/5"
        >
          <div
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-yellow-50 text-yellow-600 dark:bg-yellow-900/20 dark:text-yellow-400"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
            >
          </div>
          <div>
            <p
              class="text-sm font-bold text-gray-900 transition-colors group-hover/card:text-yellow-600 dark:text-white dark:group-hover/card:text-yellow-400"
            >
              AI Ready Plugins
            </p>
            <p class="mt-0.5 text-xs leading-snug text-gray-500 dark:text-gray-400">
              Curated plugins optimized for AI workflows
            </p>
          </div>
        </a>
        <a
          href="/recently-updated/"
          class="group/card flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50 dark:hover:bg-white/5"
        >
          <div
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-900/20 dark:text-[#ccff00]"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
          </div>
          <div>
            <p
              class="text-sm font-bold text-gray-900 transition-colors group-hover/card:text-emerald-600 dark:text-white dark:group-hover/card:text-[#ccff00]"
            >
              Recently Updated
            </p>
            <p class="mt-0.5 text-xs leading-snug text-gray-500 dark:text-gray-400">
              Extensions with the latest code commits
            </p>
          </div>
        </a>
        <a
          href="/potentially-abandoned/"
          class="group/card flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50 dark:hover:bg-white/5"
        >
          <div
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-rose-50 text-rose-600 dark:bg-rose-900/20 dark:text-rose-400"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg
            >
          </div>
          <div>
            <p
              class="text-sm font-bold text-gray-900 transition-colors group-hover/card:text-rose-600 dark:text-white dark:group-hover/card:text-rose-400"
            >
              Potentially Stale
            </p>
            <p class="mt-0.5 text-xs leading-snug text-gray-500 dark:text-gray-400">
              Plugins warning of long inactivity or archiving
            </p>
          </div>
        </a>
        <a
          href="/#install"
          class="group/card col-span-2 flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50 dark:hover:bg-white/5"
        >
          <div
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-orange-50 text-orange-600 dark:bg-orange-900/20 dark:text-orange-400"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg
            >
          </div>
          <div>
            <p
              class="text-sm font-bold text-gray-900 transition-colors group-hover/card:text-orange-600 dark:text-white dark:group-hover/card:text-orange-400"
            >
              One-click Install
            </p>
            <p class="mt-0.5 text-xs leading-snug text-gray-500 dark:text-gray-400">
              Add plugins to your install list in a single click — no manual steps required
            </p>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
