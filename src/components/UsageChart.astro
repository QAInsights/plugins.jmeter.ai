---
interface Props {
  labels: string[];
  data: number[];
}

const { labels, data } = Astro.props;
---

<div class="mb-10">
  <h4 class="mb-4 text-sm font-bold tracking-wide text-gray-900 uppercase dark:text-white">
    Usage History
  </h4>
  <div
    class="relative h-64 w-full rounded-xl border border-gray-100 bg-gray-50 p-4 dark:border-white/5 dark:bg-transparent"
    data-chart-labels={JSON.stringify(labels)}
    data-chart-data={JSON.stringify(data)}
  >
    <canvas id="pluginUsageChart"></canvas>
  </div>
</div>

<script>
  function loadChartJs(): Promise<any> {
    // @ts-ignore
    if (window.Chart) return Promise.resolve(window.Chart);
    return new Promise((resolve) => {
      const existing = document.querySelector('script[data-chartjs-loader]');
      if (existing) {
        // @ts-ignore
        existing.addEventListener('load', () => resolve(window.Chart || null), { once: true });
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
      script.async = true;
      script.setAttribute('data-chartjs-loader', '1');
      // @ts-ignore
      script.onload = () => resolve(window.Chart || null);
      script.onerror = () => resolve(null);
      document.head.appendChild(script);
    });
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const chartContainer = document.querySelector('[data-chart-labels]');
    if (!chartContainer) return;
    const labels = JSON.parse(chartContainer.getAttribute('data-chart-labels') || '[]');
    const data = JSON.parse(chartContainer.getAttribute('data-chart-data') || '[]');

    const canvas = document.getElementById('pluginUsageChart') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const isDark = document.documentElement.classList.contains('dark');
    const chartColor = isDark ? '#ccff00' : '#b0d600';

    const ChartLib = await loadChartJs();
    if (!ChartLib || !ctx) return;
    // @ts-ignore
    window.usageChartInstance = new ChartLib(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            data: data,
            borderColor: chartColor,
            borderWidth: 2,
            backgroundColor: `${chartColor}20`,
            fill: true,
            pointRadius: 0,
            pointHoverRadius: 6,
            tension: 0.3,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            mode: 'index',
            intersect: false,
            backgroundColor: isDark ? '#18181b' : '#ffffff',
            titleColor: isDark ? '#ffffff' : '#000000',
            bodyColor: isDark ? '#a1a1aa' : '#4b5563',
            borderColor: isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)',
            borderWidth: 1,
            padding: 12,
          },
        },
        scales: {
          x: { display: false },
          y: {
            grid: { color: isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)' },
            ticks: { color: isDark ? '#a1a1aa' : '#6b7280', maxTicksLimit: 6 },
            border: { display: false },
          },
        },
        interaction: { mode: 'nearest', axis: 'x', intersect: false },
      },
    });
  });
</script>
