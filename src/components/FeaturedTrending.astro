---
import PluginCard from './PluginCard.astro';
const { trendingPlugins } = Astro.props;
---

<section
  id="featuredTrendingSection"
  class="bg-gray-50/50 px-4 py-8 transition-all duration-300 sm:px-6 sm:py-10 dark:bg-white/[0.01]"
>
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 sm:gap-12 lg:grid-cols-2">
    <div class="flex flex-col">
      <div class="mb-8 flex items-center gap-3">
        <svg class="h-6 w-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
          ></path></svg
        >
        <h2 class="text-2xl font-bold dark:text-white">Featured</h2>
      </div>

      <a
        href="https://github.com/QAInsights/plugins.jmeter.ai/issues/new?template=feature_plugin.md"
        target="_blank"
        rel="noopener noreferrer"
        class="ai-glow-wrapper group flex min-h-[200px] flex-grow cursor-pointer flex-col items-center justify-center rounded-xl shadow-md transition-all hover:shadow-xl dark:shadow-[0_0_15px_rgba(155,114,203,0.1)] dark:hover:shadow-[0_0_25px_rgba(66,133,244,0.3)]"
      >
        <div
          class="dark:bg-dark-surface flex h-full w-full flex-col items-center justify-center rounded-[10px] bg-white p-8 text-center transition-colors hover:bg-gray-50 dark:hover:bg-[#1f1f22]"
        >
          <div
            class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-purple-100 transition-transform group-hover:scale-110 dark:bg-purple-500/20"
          >
            <svg
              class="h-6 w-6 text-purple-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg
            >
          </div>
          <h3
            class="group-hover:text-primary mb-2 text-xl font-bold text-gray-900 transition-colors dark:text-white dark:group-hover:text-[#ccff00]"
          >
            Feature Your Plugin
          </h3>
          <p class="max-w-sm text-sm text-gray-500 dark:text-gray-400">
            Want to reach thousands of JMeter users? Promote your plugin here across the ecosystem.
          </p>
        </div>
      </a>
    </div>

    <div class="flex flex-col">
      <div class="mb-8 flex items-center gap-3">
        <svg class="text-secondary h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg
        >
        <h2 class="text-2xl font-bold dark:text-white">Hot This Week</h2>
      </div>
      <div class="grid flex-grow grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-2">
        {trendingPlugins.slice(0, 2).map((plugin: any) => <PluginCard plugin={plugin} />)}
      </div>
    </div>
  </div>
</section>
