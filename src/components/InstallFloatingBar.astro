---

---

<div
  id="installBar"
  class="fixed right-4 bottom-4 left-4 z-[60] hidden translate-y-32 transform transition-all duration-500 sm:right-8 sm:bottom-8 sm:left-auto"
>
  <style>
    /* Stack install bar above compare bar when both are open.
           Compare bar measures ~88px; add 1rem gap. */
    #installBar.stacked {
      bottom: calc(88px + 1.25rem);
    }
  </style>
  <div
    class="dark:bg-dark-surface/90 flex w-full flex-col gap-3 rounded-2xl border border-white/10 bg-gray-900/90 p-3 shadow-2xl backdrop-blur-xl sm:max-w-[400px] sm:min-w-[320px] sm:p-4"
  >
    <div class="flex items-center justify-between border-b border-white/10 pb-2">
      <div class="flex items-center gap-2">
        <div
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-green-500/30 bg-green-500/20 text-green-500"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg
          >
        </div>
        <div>
          <p class="text-sm font-bold text-white">Install Plugins</p>
          <p
            id="installCount"
            class="text-[10px] font-bold tracking-widest text-gray-400 uppercase"
          >
            0 selected
          </p>
        </div>
      </div>
      <button
        id="clearInstall"
        class="p-1 text-[10px] font-bold tracking-widest text-gray-400 uppercase transition-colors hover:text-white"
      >
        Clear
      </button>
    </div>

    <div class="group relative rounded-lg bg-black/50 p-3">
      <div
        class="h-12 overflow-y-auto pr-8 font-mono text-xs break-all text-green-400"
        id="installCmdText"
      >
        PluginsManagerCMD.sh install
      </div>
      <button
        id="copyInstallCmd"
        class="absolute top-2 right-2 rounded bg-white/10 p-1.5 text-white transition-colors hover:bg-white/20"
        title="Copy Command"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
          ></path></svg
        >
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    let installIds = [];

    try {
      installIds = JSON.parse(localStorage.getItem('installIds') || '[]');
    } catch (e) {
      installIds = [];
    }

    function detectCmdName() {
      try {
        const uaData = navigator.userAgentData;
        if (uaData && uaData.platform) {
          if (/windows/i.test(uaData.platform)) return 'PluginsManagerCMD.bat';
        }
      } catch (e) {
        /* ignore */
      }
      const ua = (navigator.userAgent || '') + ' ' + (navigator.platform || '');
      if (/win/i.test(ua) && !/darwin|mac/i.test(ua)) return 'PluginsManagerCMD.bat';
      return 'PluginsManagerCMD.sh';
    }

    const CMD_NAME = detectCmdName();

    function updateInstallUI() {
      const bar = document.getElementById('installBar');
      const countEl = document.getElementById('installCount');
      const cmdText = document.getElementById('installCmdText');

      if (installIds.length > 0) {
        if (bar) {
          bar.classList.remove('hidden');
          setTimeout(() => bar.classList.remove('translate-y-32'), 10);
        }
      } else {
        if (bar) {
          bar.classList.add('translate-y-32');
          setTimeout(() => bar.classList.add('hidden'), 500);
        }
      }

      // On mobile, stack the install bar above the compare bar when
      // both are visible (compare bar sits bottom-center full-width).
      if (bar) {
        const compareBar = document.getElementById('compareBar');
        const compareVisible =
          compareBar &&
          !compareBar.classList.contains('hidden') &&
          !compareBar.classList.contains('translate-y-32');
        if (compareVisible && installIds.length > 0) {
          bar.classList.add('stacked');
        } else {
          bar.classList.remove('stacked');
        }
      }

      if (countEl) countEl.textContent = `${installIds.length} selected`;
      if (cmdText) cmdText.textContent = `${CMD_NAME} install ${installIds.join(',')}`;

      // Update all install buttons on the page
      document.querySelectorAll('.install-add-btn').forEach((btn) => {
        const id = btn.getAttribute('data-plugin-id');
        const isSelected = installIds.includes(id);
        const label =
          btn.querySelector(
            'span:not(.sr-only):not(.install-btn-label):not(.pointer-events-none)',
          ) ||
          btn.querySelector('span.install-btn-label') ||
          btn.querySelector('span');
        const plusIcon = btn.querySelector('.install-icon-plus');
        const checkIcon = btn.querySelector('.install-icon-check');

        // Snapshot the button's default text-color classes once, before we ever mutate them
        if (!btn.hasAttribute('data-default-colors')) {
          const defaultColors = [...btn.classList].filter(
            (c) => c.startsWith('text-') || c.startsWith('dark:text-'),
          );
          btn.setAttribute('data-default-colors', defaultColors.join(' '));
        }
        const defaultColors = (btn.getAttribute('data-default-colors') || '')
          .split(' ')
          .filter(Boolean);

        if (isSelected) {
          btn.classList.add(
            'bg-green-500/15',
            'text-green-600',
            'dark:text-green-400',
            'border-green-500/40',
          );
          defaultColors.forEach((c) => btn.classList.remove(c));
          if (plusIcon) plusIcon.classList.add('hidden');
          if (checkIcon) checkIcon.classList.remove('hidden');
          if (label && !label.classList.contains('sr-only')) label.textContent = 'Added';
        } else {
          btn.classList.remove(
            'bg-green-500/15',
            'text-green-600',
            'dark:text-green-400',
            'border-green-500/40',
          );
          defaultColors.forEach((c) => btn.classList.add(c));
          if (plusIcon) plusIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
          if (label && !label.classList.contains('sr-only')) label.textContent = 'Install';
        }
      });
    }

    function toggleInstallPlugin(id) {
      const index = installIds.indexOf(id);
      if (index > -1) {
        installIds.splice(index, 1);
      } else {
        installIds.push(id);
      }
      localStorage.setItem('installIds', JSON.stringify(installIds));
      updateInstallUI();
    }

    // Global event listener for install buttons.
    // Use CAPTURE phase so we run before inline onclick="event.stopPropagation()"
    // on .install-add-btn inside cards (otherwise bubble-phase handler never fires).
    document.addEventListener(
      'click',
      (e) => {
        const btn = e.target.closest && e.target.closest('.install-add-btn');
        if (btn) {
          e.preventDefault();
          const id = btn.getAttribute('data-plugin-id');
          if (id) {
            toggleInstallPlugin(id);
          }
          return;
        }

        if (e.target.id === 'clearInstall') {
          installIds = [];
          localStorage.setItem('installIds', JSON.stringify(installIds));
          updateInstallUI();
          return;
        }

        const copyBtn = e.target.closest && e.target.closest('#copyInstallCmd');
        if (copyBtn) {
          const cmdText = document.getElementById('installCmdText').textContent;
          navigator.clipboard.writeText(cmdText).then(() => {
            const originalHtml = copyBtn.innerHTML;
            copyBtn.innerHTML = `<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
            setTimeout(() => {
              copyBtn.innerHTML = originalHtml;
            }, 2000);
          });
        }
      },
      true,
    );

    // Initialize on load and after Astro navigation
    window.addEventListener('load', updateInstallUI);
    document.addEventListener('astro:after-swap', updateInstallUI);
    document.addEventListener('plugin:install-update', updateInstallUI);

    // Re-stack whenever the compare bar's visibility classes change.
    function observeCompareBar() {
      const compareBar = document.getElementById('compareBar');
      if (!compareBar || compareBar.__installBarObserved) return;
      compareBar.__installBarObserved = true;
      const mo = new MutationObserver(updateInstallUI);
      mo.observe(compareBar, { attributes: true, attributeFilter: ['class'] });
    }
    observeCompareBar();
    document.addEventListener('astro:after-swap', observeCompareBar);

    // Expose to cards that might be rendered dynamically
    window.refreshInstallUI = updateInstallUI;
  })();
</script>
