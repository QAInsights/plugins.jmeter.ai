---
import type { CollectionSummary } from '../utils/collection';

interface Props {
  collection: CollectionSummary;
}

const { collection } = Astro.props;

const formatNumber = (n: number) => new Intl.NumberFormat('en-US').format(n);
---

<a
  href={`/collections/${collection.id}/`}
  class="collection-card group dark:bg-dark-surface hover:border-primary/40 relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-xl dark:border-white/10 dark:hover:shadow-[0_0_20px_rgba(204,255,0,0.1)]"
  data-id={collection.id}
  data-downloads={collection.totalDownloads}
>
  <div class="mb-4 flex items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="text-3xl leading-none" aria-hidden="true">{collection.emoji}</span>
      <h3
        class="group-hover:text-green-600 text-xl leading-snug font-bold text-gray-900 transition-colors dark:text-white dark:group-hover:text-[#ccff00]"
      >
        {collection.name}
      </h3>
    </div>
    <span
      class="shrink-0 rounded-full bg-gray-100 px-2.5 py-1 text-[10px] font-bold whitespace-nowrap text-gray-600 dark:bg-white/5 dark:text-gray-300"
    >
      {collection.pluginCount} plugins
    </span>
  </div>

  <p class="mb-5 flex-grow text-sm leading-relaxed text-gray-600 dark:text-gray-400">
    {collection.tagline}
  </p>

  {
    collection.previewPlugins.length > 0 && (
      <div class="mb-5 flex flex-wrap gap-1.5">
        {collection.previewPlugins.map((p) => (
          <span class="rounded border border-gray-200 bg-gray-100 px-2 py-0.5 font-mono text-[10px] font-semibold text-gray-500 dark:border-white/5 dark:bg-white/5 dark:text-gray-400">
            {p.id}
          </span>
        ))}
        {collection.pluginCount > 3 && (
          <span class="rounded px-2 py-0.5 text-[10px] font-semibold text-gray-400 dark:text-gray-500">
            +{collection.pluginCount - 3} more
          </span>
        )}
      </div>
    )
  }

  <div
    class="mt-auto flex items-center justify-between border-t border-gray-100 pt-4 dark:border-white/5"
  >
    <div class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
      <svg
        class="text-green-600 h-3.5 w-3.5 dark:text-[#ccff00]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      <span class="font-medium text-gray-700 dark:text-gray-300"
        >{formatNumber(collection.totalDownloads)}</span
      >
      <span>total downloads</span>
    </div>

    <span
      class="text-green-600 inline-flex items-center gap-1 text-xs font-bold transition-all group-hover:gap-2 dark:text-[#ccff00]"
    >
      View Stack
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </span>
  </div>
</a>
