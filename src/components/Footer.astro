---
const lastSyncDate = new Date().toUTCString().replace('GMT', 'UTC');
---

<footer
  class="dark:bg-dark-bg/50 mt-auto border-t border-gray-200 bg-gray-50/50 px-4 py-10 backdrop-blur-sm sm:px-6 sm:py-16 dark:border-white/10"
>
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-3">
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-xl font-extrabold tracking-tight text-gray-900 dark:text-white"
            >Perf<span class="text-green-600 dark:text-[#ccff00]">Atlas</span></span
          >
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-gray-500 dark:text-gray-400">
          The modern directory for JMeter plugins. Tracking daily performance trends and community
          growth.
        </p>
        <div class="flex items-center gap-4">
          <a
            href="https://x.com/qainsights"
            target="_blank"
            rel="noopener"
            class="text-gray-400 transition-colors hover:text-white"
            aria-label="X (Twitter)"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
              ></path></svg
            >
          </a>
          <a
            href="https://youtube.com/@qainsights"
            target="_blank"
            rel="noopener"
            class="text-gray-400 transition-colors hover:text-[#FF0000]"
            aria-label="YouTube"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505a3.017 3.017 0 00-2.122 2.136C0 8.055 0 12 0 12s0 3.945.501 5.814a3.015 3.015 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.945 24 12 24 12s0-3.945-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
              ></path></svg
            >
          </a>
          <a
            href="https://linkedin.com/in/naveenkumarn"
            target="_blank"
            rel="noopener"
            class="text-gray-400 transition-colors hover:text-[#0A66C2]"
            aria-label="LinkedIn"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
          </a>
          <a
            href="https://github.com/qainsights"
            target="_blank"
            rel="noopener"
            class="text-gray-400 transition-colors hover:text-white"
            aria-label="GitHub"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 md:col-span-2">
        <div class="space-y-4">
          <h4 class="text-sm font-bold tracking-widest text-gray-900 uppercase dark:text-white">
            Platform
          </h4>
          <ul class="space-y-2 text-sm text-gray-500 dark:text-gray-400">
            <li>
              <a
                href="/blog/"
                class="transition-colors hover:text-green-600 dark:hover:text-[#ccff00]">Blog</a
              >
            </li>
            <li>
              <a
                href="https://jmeter.ai"
                class="transition-colors hover:text-green-600 dark:hover:text-[#ccff00]"
                >JMeter.ai</a
              >
            </li>
            <li>
              <a
                href="https://ai.dosa.dev"
                class="transition-colors hover:text-green-600 dark:hover:text-[#ccff00]"
                >AI Collections</a
              >
            </li>
          </ul>
        </div>
        <div class="space-y-4">
          <h4 class="text-sm font-bold tracking-widest text-gray-900 uppercase dark:text-white">
            Network
          </h4>
          <ul class="space-y-2 text-sm text-gray-500 dark:text-gray-400">
            <li>
              <a
                href="https://qainsights.com"
                class="transition-colors hover:text-green-600 dark:hover:text-[#ccff00]"
                >QAInsights</a
              >
            </li>
            <li>
              <a
                href="https://dosa.dev"
                class="transition-colors hover:text-green-600 dark:hover:text-[#ccff00]"
                >Portfolio</a
              >
            </li>
            <li>
              <a
                href="https://www.buymeacoffee.com/qainsights"
                class="transition-colors hover:text-green-600 dark:hover:text-[#ccff00]"
                >Support Development</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-6 border-t border-gray-200 pt-8 text-xs font-medium text-gray-500 md:flex-row dark:border-white/5 dark:text-gray-400"
    >
      <p>
        &copy; {new Date().getFullYear()} PerfAtlas. Built by <a
          href="https://dosa.dev"
          class="text-gray-900 hover:underline dark:text-white">NaveenKumar Namachivayam</a
        >.
      </p>
      <div class="flex items-center gap-4">
        <span
          >Last directory sync: <span
            class="ml-1 rounded bg-gray-200 px-1.5 py-0.5 font-mono dark:bg-white/5"
            >{lastSyncDate}</span
          ></span
        >
      </div>
    </div>
    <div
      class="mt-8 border-t border-gray-200 pt-8 text-[11px] leading-relaxed text-gray-400 dark:border-white/5 dark:text-gray-500"
    >
      <p>
        Apache, Apache JMeter, JMeter, and the Apache JMeter logo are trademarks of the Apache
        Software Foundation. This site is an independent community resource and is not affiliated
        with, endorsed by, or sponsored by the Apache Software Foundation.
      </p>
    </div>
  </div>
</footer>
