---
import type { ChangelogEntry } from '../utils/plugin';

interface Props {
  entries: ChangelogEntry[];
  initialVisible?: number;
}

const { entries, initialVisible = 5 } = Astro.props;
---

<div class="mb-10">
  <h4 class="mb-6 text-sm font-bold tracking-wide text-gray-900 uppercase dark:text-white">
    Release History
    <span class="ml-1 font-normal text-gray-400 normal-case dark:text-gray-500"
      >({entries.length})</span
    >
  </h4>
  <ol
    id="changelogTimeline"
    class="changelog-timeline relative ml-2 space-y-8 border-l-2 border-gray-200 pl-8 dark:border-white/10"
    data-initial-visible={initialVisible}
    data-total={entries.length}
  >
    {
      entries.map((entry, i) => (
        <li
          class={`changelog-entry relative ${i >= initialVisible ? 'hidden' : ''}`}
          data-index={i}
        >
          <span class="border-primary dark:bg-dark-surface ring-primary/10 absolute top-1 -left-[42px] h-4 w-4 rounded-full border-2 bg-white shadow ring-4" />
          <div class="mb-2 flex flex-wrap items-baseline gap-3">
            <span class="text-lg font-black text-gray-900 dark:text-white">v{entry.version}</span>
            {i === 0 && (
              <span class="bg-primary/15 text-primary rounded-full px-2 py-0.5 text-[10px] font-bold tracking-wide uppercase">
                Latest
              </span>
            )}
          </div>
          <p class="mb-3 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {entry.changes ?? 'No release notes provided.'}
          </p>
          {(entry.downloadUrl || entry.libs.length > 0) && (
            <div class="flex flex-wrap items-center gap-4 text-xs">
              {entry.downloadUrl && (
                <a
                  href={entry.downloadUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary inline-flex items-center gap-1.5 font-semibold hover:underline"
                >
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4"
                    />
                  </svg>
                  Download JAR
                </a>
              )}
              {entry.libs.length > 0 && (
                <details class="group">
                  <summary class="cursor-pointer font-semibold text-gray-500 select-none hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">
                    {entry.libs.length} bundled {entry.libs.length === 1 ? 'library' : 'libraries'}
                  </summary>
                  <ul class="mt-2 ml-1 space-y-1 font-mono text-[11px] text-gray-500 dark:text-gray-400">
                    {entry.libs.map((l) => (
                      <li>
                        <span class="mr-1">&bull;</span>
                        <a
                          class="hover:text-primary break-all"
                          href={l.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {l.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          )}
        </li>
      ))
    }
  </ol>
  {
    entries.length > initialVisible && (
      <button
        type="button"
        id="toggleChangelog"
        class="hover:text-primary mt-6 inline-flex items-center gap-2 text-sm font-bold text-gray-700 transition-colors dark:text-gray-300"
        data-expanded="false"
        aria-expanded="false"
        aria-controls="changelogTimeline"
        data-total={entries.length}
      >
        <span class="label">Show all {entries.length} versions</span>
        <svg
          class="chevron h-4 w-4 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"
          />
        </svg>
      </button>
    )
  }
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('toggleChangelog');
    if (!toggleBtn) return;
    const timelineEl = document.getElementById('changelogTimeline');
    const initialVisible = timelineEl
      ? parseInt(timelineEl.getAttribute('data-initial-visible') || '5', 10)
      : 5;
    const total = parseInt(toggleBtn.getAttribute('data-total') || '0', 10);
    const labelEl = toggleBtn.querySelector('.label');
    const chevron = toggleBtn.querySelector('.chevron');
    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('data-expanded') === 'true';
      const next = !expanded;
      toggleBtn.setAttribute('data-expanded', String(next));
      toggleBtn.setAttribute('aria-expanded', String(next));
      document.querySelectorAll('.changelog-entry').forEach((el) => {
        const idx = parseInt((el as HTMLElement).getAttribute('data-index') || '0', 10);
        if (idx >= initialVisible) {
          el.classList.toggle('hidden', !next);
        }
      });
      if (labelEl) {
        labelEl.textContent = next ? 'Show latest only' : `Show all ${total} versions`;
      }
      if (chevron) {
        chevron.classList.toggle('rotate-180', next);
      }
    });
  });
</script>
