---
/**
 * UserMenu Component
 *
 * Displays user avatar and dropdown menu for authenticated users.
 */

import { SignOutButton } from '@clerk/astro/components';
---

<div class="user-menu relative">
  <button
    class="menu-trigger dark:bg-dark-surface flex items-center gap-2 rounded-full border border-gray-200 bg-gray-100 p-1 pr-3 transition-colors hover:bg-gray-200 dark:border-white/10 dark:hover:bg-white/10"
  >
    <img class="user-avatar h-7 w-7 rounded-full bg-gray-300" src="" alt="User avatar" />
    <svg
      class="h-4 w-4 text-gray-500 dark:text-gray-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>

  {/* Custom Dropdown */}
  <div
    class="dropdown dark:bg-dark-surface absolute right-0 z-50 mt-2 hidden w-48 rounded-lg border border-gray-200 bg-white py-1 shadow-lg dark:border-white/10"
  >
    <div class="user-info border-b border-gray-100 px-4 py-2 dark:border-white/5">
      <p class="user-name truncate text-sm font-semibold text-gray-900 dark:text-white"></p>
      <p class="user-email truncate text-xs text-gray-500 dark:text-gray-400"></p>
    </div>
    <a
      href="/settings/"
      class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 transition-colors hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      Settings
    </a>
    <SignOutButton asChild>
      <button
        class="flex w-full items-center gap-2 px-4 py-2 text-left text-sm text-red-600 transition-colors hover:bg-gray-100 dark:text-red-400 dark:hover:bg-white/5"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
          ></path>
        </svg>
        Sign Out
      </button>
    </SignOutButton>
  </div>
</div>

<script>
  import { $userStore } from '@clerk/astro/client';

  const userMenu = document.querySelector('.user-menu');
  const dropdown = userMenu?.querySelector('.dropdown');
  const userAvatar = userMenu?.querySelector('.user-avatar') as HTMLImageElement | null;
  const userName = userMenu?.querySelector('.user-name');
  const userEmail = userMenu?.querySelector('.user-email');
  const menuButton = userMenu?.querySelector('.menu-trigger');

  // Update user info
  $userStore.subscribe((user) => {
    if (user && userAvatar && userName && userEmail) {
      userAvatar.src = user.imageUrl || '';
      userAvatar.alt = user.fullName || user.username || 'User';
      userName.textContent = user.fullName || user.username || 'User';
      userEmail.textContent = user.primaryEmailAddress?.emailAddress || '';
    }
  });

  // Toggle dropdown
  menuButton?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle('hidden');
  });

  // Close when clicking outside
  document.addEventListener('click', () => {
    dropdown?.classList.add('hidden');
  });
</script>
