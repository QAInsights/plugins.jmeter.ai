---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import pluginsData from '../../data/plugins_data.json';
import { getVendors } from '../../utils/plugin';

const vendors = getVendors(pluginsData as any[]);

const formatNumber = (n: number) => new Intl.NumberFormat('en-US').format(n);

const totalPlugins = vendors.reduce((sum, v) => sum + v.pluginCount, 0);
const totalDownloads = vendors.reduce((sum, v) => sum + v.totalDownloads, 0);
const totalAiReady = vendors.reduce((sum, v) => sum + v.aiReadyCount, 0);

const [first, second, third] = vendors;
const podium = [first, second, third].filter(Boolean);

const title = 'Vendors & Leaderboard | PerfAtlas';
const description = `Browse ${vendors.length} JMeter plugin vendors on PerfAtlas, ranked by total downloads. Discover the teams behind ${formatNumber(totalPlugins)} plugins with ${formatNumber(totalDownloads)} cumulative downloads.`;
---

<Layout title={title} description={description} image="/og/vendor/index.png">
  <Header />
  <main class="flex flex-grow flex-col px-6 py-12 md:py-16">
    <div class="mx-auto w-full max-w-7xl">
      {/* Back Link */}
      <a
        href="/"
        class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition-colors hover:text-gray-900 dark:hover:text-white"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
        >
        Back to Directory
      </a>

      {/* Page Hero */}
      <div class="mb-12">
        <p
          class="mb-3 text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400"
        >
          Leaderboard
        </p>
        <h1
          class="mb-4 text-4xl leading-tight font-black tracking-tighter text-gray-900 md:text-6xl dark:text-white"
        >
          JMeter Plugin <span
            class="bg-gradient-to-r from-green-400 to-[#ccff00] bg-clip-text text-transparent"
            >Vendors</span
          >
        </h1>
        <p class="max-w-3xl text-lg leading-relaxed text-gray-600 dark:text-gray-300">
          {vendors.length} teams and maintainers shipping JMeter plugins; ranked by total downloads, complete
          with per-vendor catalogs.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
          <div
            class="dark:bg-dark-surface rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10"
          >
            <h4 class="mb-2 text-xs font-bold tracking-wide text-gray-500 uppercase">Vendors</h4>
            <p class="text-2xl font-black text-gray-900 md:text-3xl dark:text-white">
              {formatNumber(vendors.length)}
            </p>
          </div>
          <div
            class="dark:bg-dark-surface rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10"
          >
            <h4 class="mb-2 text-xs font-bold tracking-wide text-gray-500 uppercase">Plugins</h4>
            <p class="text-2xl font-black text-gray-900 md:text-3xl dark:text-white">
              {formatNumber(totalPlugins)}
            </p>
          </div>
          <div
            class="dark:bg-dark-surface rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10"
          >
            <h4 class="mb-2 text-xs font-bold tracking-wide text-gray-500 uppercase">
              Cumulative Downloads
            </h4>
            <p class="text-2xl font-black text-gray-900 md:text-3xl dark:text-white">
              {formatNumber(totalDownloads)}
            </p>
          </div>
          <div
            class="dark:bg-dark-surface rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10"
          >
            <h4 class="mb-2 text-xs font-bold tracking-wide text-gray-500 uppercase">AI Ready</h4>
            <p class="text-2xl font-black text-gray-900 md:text-3xl dark:text-white">
              {formatNumber(totalAiReady)}
            </p>
          </div>
        </div>
      </div>

      {/* Podium */}
      {
        podium.length === 3 && (
          <div class="mb-16">
            <h2 class="mb-6 text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400">
              Top Vendors
            </h2>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
              {podium.map((v, i) => (
                <a
                  href={`/vendor/${v.slug}/`}
                  class={`group relative flex flex-col overflow-hidden rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${
                    i === 0
                      ? 'dark:bg-dark-surface border-primary/50 shadow-primary/10 bg-white shadow-lg dark:border-[#ccff00]/30 dark:shadow-[0_0_25px_rgba(204,255,0,0.1)]'
                      : 'dark:bg-dark-surface hover:border-primary/40 border-gray-200 bg-white dark:border-white/10'
                  }`}
                >
                  <div
                    class={`absolute top-0 left-0 h-1 w-full ${
                      i === 0
                        ? 'from-primary to-secondary bg-gradient-to-r'
                        : i === 1
                          ? 'bg-gradient-to-r from-gray-300 to-gray-400 dark:from-gray-500 dark:to-gray-600'
                          : 'bg-gradient-to-r from-amber-400 to-amber-600'
                    }`}
                  />
                  <div class="flex flex-col gap-4 p-6">
                    <div class="flex items-center justify-between">
                      <span
                        class={`text-2xl font-black ${
                          i === 0
                            ? 'text-primary dark:text-[#ccff00]'
                            : i === 1
                              ? 'text-gray-400'
                              : 'text-amber-500'
                        }`}
                      >
                        #{i + 1}
                      </span>
                      <span class="text-[10px] font-bold tracking-widest text-gray-400 uppercase dark:text-gray-500">
                        Top {i + 1}
                      </span>
                    </div>
                    <h3 class="group-hover:text-primary text-2xl leading-tight font-black text-gray-900 transition-colors dark:text-white dark:group-hover:text-[#ccff00]">
                      {v.vendor}
                    </h3>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                      <div>
                        <p class="text-[10px] font-bold tracking-wider text-gray-400 uppercase dark:text-gray-500">
                          Plugins
                        </p>
                        <p class="font-bold text-gray-900 dark:text-white">
                          {formatNumber(v.pluginCount)}
                        </p>
                      </div>
                      <div>
                        <p class="text-[10px] font-bold tracking-wider text-gray-400 uppercase dark:text-gray-500">
                          Downloads
                        </p>
                        <p class="font-bold text-gray-900 dark:text-white">
                          {formatNumber(v.totalDownloads)}
                        </p>
                      </div>
                    </div>
                    {v.topPlugin && (
                      <div class="border-t border-gray-100 pt-3 dark:border-white/5">
                        <p class="mb-1 text-[10px] font-bold tracking-wider text-gray-400 uppercase dark:text-gray-500">
                          Flagship
                        </p>
                        <p class="line-clamp-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                          {v.topPlugin.name}
                        </p>
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* Controls */}
      <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-center">
        <div class="relative w-full md:max-w-sm">
          <span class="absolute top-1/2 left-4 -translate-y-1/2 text-gray-400">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
            >
          </span>
          <input
            type="search"
            id="vendorSearch"
            name="q"
            placeholder="Search vendors..."
            aria-label="Search vendors"
            autocomplete="off"
            class="dark:bg-dark-surface focus:border-primary/50 w-full rounded-lg border border-gray-200 bg-white py-3 pr-4 pl-12 text-sm text-gray-900 placeholder-gray-400 transition-colors outline-none dark:border-white/10 dark:text-white dark:placeholder-white/30"
          />
        </div>

        <div class="flex items-center gap-3">
          <select
            id="vendorIndexSort"
            class="dark:bg-dark-surface focus:border-primary/50 cursor-pointer appearance-none rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm focus:outline-none dark:border-white/10 dark:text-gray-300"
          >
            <option value="downloads-desc">Sort by: Downloads</option>
            <option value="trending-desc">Trending</option>
            <option value="plugins-desc">Plugin Count</option>
            <option value="ai-desc">AI Ready</option>
            <option value="name-asc">Name: A to Z</option>
          </select>
          <span
            id="vendorIndexCount"
            class="shrink-0 truncate rounded-lg bg-gray-100 px-3 py-2 text-sm font-bold text-gray-500 dark:bg-white/10 dark:text-gray-400"
            >{vendors.length} vendors</span
          >
        </div>
      </div>

      <div
        id="vendorIndexNoResults"
        class="hidden rounded-2xl border border-gray-200 bg-gray-50 py-20 text-center dark:border-white/5 dark:bg-white/[0.01]"
      >
        <h3 class="text-xl text-gray-500 dark:text-gray-400">No vendors match your search.</h3>
      </div>

      {/* Full list (includes the podium so sort/search stays consistent) */}
      <div id="vendorIndexGrid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          vendors.map((v, index) => (
            <a
              href={`/vendor/${v.slug}/`}
              class="vendor-card group dark:bg-dark-surface hover:border-primary/40 relative flex flex-col rounded-xl border border-gray-200 bg-white p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg dark:border-white/10"
              data-name={v.vendor.toLowerCase()}
              data-downloads={v.totalDownloads}
              data-trending={v.totalTrending}
              data-plugins={v.pluginCount}
              data-ai={v.aiReadyCount}
              data-index={index}
            >
              <div class="mb-3 flex items-start justify-between gap-3">
                <h3 class="group-hover:text-primary line-clamp-2 text-lg leading-snug font-bold text-gray-900 transition-colors dark:text-white dark:group-hover:text-[#ccff00]">
                  {v.vendor}
                </h3>
                <span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-bold text-gray-600 dark:bg-white/5 dark:text-gray-300">
                  #{index + 1}
                </span>
              </div>

              <div class="mb-3 grid grid-cols-3 gap-2">
                <div>
                  <p class="text-[9px] font-bold tracking-wider text-gray-400 uppercase dark:text-gray-500">
                    Plugins
                  </p>
                  <p class="text-sm font-bold text-gray-900 dark:text-white">
                    {formatNumber(v.pluginCount)}
                  </p>
                </div>
                <div>
                  <p class="text-[9px] font-bold tracking-wider text-gray-400 uppercase dark:text-gray-500">
                    Downloads
                  </p>
                  <p class="text-sm font-bold text-gray-900 dark:text-white">
                    {formatNumber(v.totalDownloads)}
                  </p>
                </div>
                <div>
                  <p class="text-[9px] font-bold tracking-wider text-gray-400 uppercase dark:text-gray-500">
                    This Week
                  </p>
                  <p
                    class={`text-sm font-bold ${v.totalTrending > 0 ? 'text-green-600 dark:text-green-400' : v.totalTrending < 0 ? 'text-red-500' : 'text-gray-500 dark:text-gray-400'}`}
                  >
                    {v.totalTrending > 0 ? '+' : ''}
                    {formatNumber(v.totalTrending)}
                  </p>
                </div>
              </div>

              {v.aiReadyCount > 0 && (
                <span class="bg-primary/20 text-primary-dark border-primary/40 mb-3 inline-flex items-center gap-1 self-start rounded border px-2 py-0.5 text-[10px] font-bold tracking-wide uppercase dark:text-[#ccff00]">
                  {v.aiReadyCount} AI Ready
                </span>
              )}

              {v.topPlugin && (
                <p class="mt-auto line-clamp-1 border-t border-gray-100 pt-2 text-xs text-gray-500 dark:border-white/5 dark:text-gray-400">
                  <span class="font-bold text-gray-700 dark:text-gray-300">Top:</span>{' '}
                  {v.topPlugin.name}
                </p>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('vendorIndexGrid');
    const searchInput = document.getElementById('vendorSearch') as HTMLInputElement | null;
    const sortSelect = document.getElementById('vendorIndexSort') as HTMLSelectElement | null;
    const count = document.getElementById('vendorIndexCount');
    const noResults = document.getElementById('vendorIndexNoResults');

    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.vendor-card'));
    const cache = cards.map((el) => ({
      el,
      name: el.getAttribute('data-name') || '',
      downloads: parseInt(el.getAttribute('data-downloads') || '0', 10),
      trending: parseInt(el.getAttribute('data-trending') || '0', 10),
      plugins: parseInt(el.getAttribute('data-plugins') || '0', 10),
      ai: parseInt(el.getAttribute('data-ai') || '0', 10),
      index: parseInt(el.getAttribute('data-index') || '0', 10),
    }));

    let search = '';

    function applySort() {
      if (!sortSelect) return;
      const value = sortSelect.value;
      const sorted = cache.slice().sort((a, b) => {
        if (value === 'name-asc') return a.name.localeCompare(b.name);
        if (value === 'trending-desc') return b.trending - a.trending;
        if (value === 'plugins-desc') return b.plugins - a.plugins;
        if (value === 'ai-desc') {
          const diff = b.ai - a.ai;
          return diff !== 0 ? diff : b.downloads - a.downloads;
        }
        return b.downloads - a.downloads;
      });
      requestAnimationFrame(() => {
        sorted.forEach((item, i) => {
          item.el.style.order = String(i);
        });
      });
    }

    function applyFilter() {
      let matched = 0;
      cache.forEach((item) => {
        const isMatch = search === '' || item.name.includes(search);
        if (isMatch) {
          matched++;
          item.el.classList.remove('hidden');
        } else {
          item.el.classList.add('hidden');
        }
      });
      if (count) {
        count.textContent = `${matched} vendor${matched !== 1 ? 's' : ''}`;
      }
      if (noResults) {
        noResults.classList.toggle('hidden', matched !== 0);
      }
    }

    if (searchInput) {
      let debounceTimer: number | null = null;
      searchInput.addEventListener('input', (e) => {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => {
          search = (e.target as HTMLInputElement).value.toLowerCase().trim();
          applyFilter();
        }, 200);
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', applySort);
    }

    applySort();
    applyFilter();
  });
</script>
