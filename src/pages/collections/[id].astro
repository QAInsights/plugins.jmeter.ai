---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import CollectionInstallBlock from '../../components/CollectionInstallBlock.astro';
import CollectionPluginRow from '../../components/CollectionPluginRow.astro';
import AskAboutPage from '../../components/AskAboutPage.astro';
import pluginsData from '../../data/plugins_data.json';
import rawCollections from '../../data/collections.json';
import {
  getCollections,
  getRelatedCollections,
  getCollectionSummaries,
} from '../../utils/collection';

export async function getStaticPaths() {
  const collections = getCollections(pluginsData as any[], rawCollections as any[]);
  return collections.map((col) => ({
    params: { id: col.id },
    props: { collection: col, allCollections: collections },
  }));
}

const { collection, allCollections } = Astro.props;

const relatedCollections = getRelatedCollections(collection, allCollections, 3);
const relatedSummaries = getCollectionSummaries(relatedCollections);

const pluginIds = collection.plugins.map((p: any) => p.id);

const formatNumber = (n: number) => new Intl.NumberFormat('en-US').format(n);

const title = `${collection.name} | PerfAtlas Collections`;
const description = `${collection.tagline} Curated by ${collection.curator.name}, ${collection.curator.org}. ${collection.pluginCount} plugins, ${formatNumber(collection.totalDownloads)} total downloads.`;
const ogImage = `/og/collections/${collection.id}.png`;
---

<Layout title={title} description={description} image={ogImage}>
  <Header />
  <main class="flex flex-grow flex-col px-4 py-8 sm:px-6 sm:py-16">
    <div class="mx-auto w-full max-w-4xl">
      {/* Back Link */}
      <a
        href="/collections/"
        class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition-colors hover:text-gray-900 dark:hover:text-white"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
        >
        All Collections
      </a>

      <AskAboutPage
        prompt={`Explain the "${collection.name}" JMeter plugin collection and when to use it`}
        class="mb-8"
      />

      {/* Header Card */}
      <div
        class="dark:bg-dark-surface mb-8 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xl dark:border-white/10"
      >
        <div class="from-primary to-secondary h-1 bg-gradient-to-r"></div>
        <div class="p-6 sm:p-10">
          <div class="mb-6 flex flex-col justify-between gap-6 md:flex-row md:items-start">
            <div class="flex items-start gap-4">
              <span class="text-5xl leading-none" aria-hidden="true">{collection.emoji}</span>
              <div>
                <h1
                  class="mb-1 text-3xl leading-tight font-black tracking-tight text-gray-900 md:text-4xl dark:text-white"
                >
                  {collection.name}
                </h1>
                <p class="text-sm font-semibold text-gray-500 dark:text-gray-400">
                  {collection.tagline}
                </p>
              </div>
            </div>

            {/* Curator Badge */}
            <a
              href={collection.curator.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:border-primary/50 inline-flex shrink-0 items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-xs font-semibold whitespace-nowrap text-gray-700 transition-colors dark:border-white/10 dark:bg-white/5 dark:text-gray-300"
            >
              <svg
                class="text-green-600 h-4 w-4 dark:text-[#ccff00]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path></svg
              >
              By {collection.curator.name}, {collection.curator.org}
            </a>
          </div>

          <p class="mb-8 text-base leading-relaxed text-gray-600 dark:text-gray-300">
            {collection.description}
          </p>

          {/* Stats */}
          <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div
              class="rounded-xl border border-gray-100 bg-gray-50 p-5 dark:border-white/5 dark:bg-black/20"
            >
              <h4 class="mb-1 text-[10px] font-bold tracking-wide text-gray-500 uppercase">
                Plugins in Stack
              </h4>
              <p class="text-2xl font-black text-gray-900 dark:text-white">
                {collection.pluginCount}
              </p>
            </div>
            <div
              class="rounded-xl border border-gray-100 bg-gray-50 p-5 dark:border-white/5 dark:bg-black/20"
            >
              <h4 class="mb-1 text-[10px] font-bold tracking-wide text-gray-500 uppercase">
                Total Downloads
              </h4>
              <p class="text-2xl font-black text-gray-900 dark:text-white">
                {formatNumber(collection.totalDownloads)}
              </p>
            </div>
            <div
              class="rounded-xl border border-gray-100 bg-gray-50 p-5 dark:border-white/5 dark:bg-black/20"
            >
              <h4 class="mb-1 text-[10px] font-bold tracking-wide text-gray-500 uppercase">
                Trending This Week
              </h4>
              <p
                class={`text-2xl font-black ${collection.totalTrending >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-500'}`}
              >
                {collection.totalTrending >= 0 ? '+' : ''}{formatNumber(collection.totalTrending)}
              </p>
            </div>
          </div>

          {/* Install Section */}
          <div class="mb-2">
            <h2
              class="mb-3 text-sm font-bold tracking-widest text-gray-900 uppercase dark:text-white"
            >
              Install entire stack
            </h2>
            <CollectionInstallBlock pluginIds={pluginIds} collectionName={collection.name} />
          </div>
        </div>
      </div>

      {/* Plugin List */}
      <section class="mb-12">
        <h2 class="mb-6 text-xl font-bold text-gray-900 dark:text-white">Plugins in this stack</h2>

        <div class="flex flex-col gap-6">
          {
            collection.plugins.map((plugin: any) => (
              <CollectionPluginRow plugin={plugin} reason={collection.reasons[plugin.id]} />
            ))
          }
        </div>
      </section>

      {/* Related Collections */}
      {
        relatedSummaries.length > 0 && (
          <section class="border-t border-gray-100 pt-10 dark:border-white/10">
            <h2 class="mb-6 text-xl font-bold text-gray-900 dark:text-white">
              Related Collections
            </h2>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {relatedSummaries.map((rel) => (
                <CollectionCard collection={rel} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>
