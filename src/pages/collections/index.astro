---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import pluginsData from '../../data/plugins_data.json';
import rawCollections from '../../data/collections.json';
import { getCollections, getCollectionSummaries } from '../../utils/collection';

const collections = getCollections(pluginsData as any[], rawCollections as any[]);
const summaries = getCollectionSummaries(collections);

const formatNumber = (n: number) => new Intl.NumberFormat('en-US').format(n);

const totalPluginsAcrossStacks = collections.reduce((sum, c) => sum + c.pluginCount, 0);
const totalDownloadsAcrossStacks = collections.reduce((sum, c) => sum + c.totalDownloads, 0);

const title = 'Collections | PerfAtlas';
const description = `Curated JMeter plugin stacks for every use case. ${collections.length} hand-picked collections covering CI/CD, observability, load shaping, and AI-powered testing.`;
---

<Layout title={title} description={description} image="/og/collections/index.png">
  <Header />
  <main class="flex flex-grow flex-col px-6 py-12 md:py-16">
    <div class="mx-auto w-full max-w-7xl">
      {/* Back Link */}
      <a
        href="/"
        class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition-colors hover:text-gray-900 dark:hover:text-white"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
        >
        Back to Directory
      </a>

      {/* Hero */}
      <div class="mb-12">
        <p
          class="mb-3 text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400"
        >
          Collections
        </p>
        <h1
          class="mb-4 text-4xl leading-tight font-black tracking-tighter text-gray-900 md:text-6xl dark:text-white"
        >
          Curated plugin stacks <span
            class="bg-gradient-to-r from-green-500 to-green-600 bg-clip-text text-transparent dark:from-green-400 dark:to-[#ccff00]"
            >for every use case</span
          >
        </h1>
        <p class="max-w-3xl text-lg leading-relaxed text-gray-600 dark:text-gray-300">
          Hand-picked groups of JMeter plugins that work better together. Each stack comes with an
          install command you can drop straight into your pipeline.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
          <div
            class="dark:bg-dark-surface rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10"
          >
            <h4 class="mb-2 text-xs font-bold tracking-wide text-gray-500 uppercase">Stacks</h4>
            <p class="text-2xl font-black text-gray-900 md:text-3xl dark:text-white">
              {collections.length}
            </p>
          </div>
          <div
            class="dark:bg-dark-surface rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10"
          >
            <h4 class="mb-2 text-xs font-bold tracking-wide text-gray-500 uppercase">
              Plugins Covered
            </h4>
            <p class="text-2xl font-black text-gray-900 md:text-3xl dark:text-white">
              {formatNumber(totalPluginsAcrossStacks)}
            </p>
          </div>
          <div
            class="dark:bg-dark-surface col-span-2 rounded-xl border border-gray-200 bg-white p-5 md:col-span-1 dark:border-white/10"
          >
            <h4 class="mb-2 text-xs font-bold tracking-wide text-gray-500 uppercase">
              Total Downloads
            </h4>
            <p class="text-2xl font-black text-gray-900 md:text-3xl dark:text-white">
              {formatNumber(totalDownloadsAcrossStacks)}
            </p>
          </div>
        </div>
      </div>

      {/* Collections Grid */}
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {summaries.map((col) => <CollectionCard collection={col} />)}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
