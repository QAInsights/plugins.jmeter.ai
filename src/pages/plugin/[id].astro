---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import UsageChart from '../../components/UsageChart.astro';
import WeeklyHeatmap from '../../components/WeeklyHeatmap.astro';
import ChangelogTimeline from '../../components/ChangelogTimeline.astro';
import GitHubBadge from '../../components/GitHubBadge.astro';
import RelatedPluginsSection from '../../components/RelatedPluginsSection.astro';
import CommunityDiscussions from '../../components/CommunityDiscussions.astro';
import pluginsData from '../../data/plugins_data.json';
import {
  getRelatedPlugins,
  inferCategory,
  getChangelogTimeline,
  hasChangelog,
  vendorSlug,
} from '../../utils/plugin';

// Make this a statically generated route
export async function getStaticPaths() {
  return pluginsData.map((plugin) => ({
    params: { id: plugin.id },
    props: { plugin },
  }));
}

const { plugin } = Astro.props;

// Format data just like the Modal
const dlAbsolute = new Intl.NumberFormat('en-US').format(plugin.stats.absoluteDownloads);
const trendArrow = plugin.stats.trendingDelta > 0 ? '+' : '';
const trendDelta = new Intl.NumberFormat('en-US').format(plugin.stats.trendingDelta);

// Determine the active screenshot
let sUrl = plugin.screenshotUrl || '';
if (sUrl && !sUrl.startsWith('http')) {
  sUrl = 'https://jmeter-plugins.org' + (sUrl.startsWith('/') ? '' : '/') + sUrl;
}

// Prebuild (scripts/generateOgImages.mts) emits a card PNG per plugin into
// /public/og/plugin/<id>.png. We always link to that generated asset so every
// plugin gets a distinctive share preview on Twitter / LinkedIn / Slack etc.
const ogImage = `/og/plugin/${plugin.id}.png`;

const title = `${plugin.name} | PerfAtlas`;
const healthText = plugin.githubInfo?.health
  ? ` Health score: ${plugin.githubInfo.health.score}/100 (${plugin.githubInfo.health.label}).`
  : '';
const description = `Discover ${plugin.name} by ${plugin.vendor}. ${plugin.description}${healthText}`;
const url = `https://plugins.jmeter.ai/plugin/${plugin.id}/`;

// Prepare Chart Data
const history = (plugin.stats.history || {}) as Record<string, number>;
const chartLabels = Object.keys(history).sort();
const chartData = chartLabels.map((l) => history[l]);

// Related plugins (same vendor / same inferred category)
const { sameVendor, sameCategory } = getRelatedPlugins(plugin, pluginsData, { limit: 3 });
const relatedCategory = inferCategory(plugin);

// Release history / changelog timeline
const changelog = getChangelogTimeline(plugin);
const showChangelog = hasChangelog(plugin);

// SoftwareApplication schema — enables rich results in Google, Bing, and AI search
const siteBase = 'https://plugins.jmeter.ai';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: plugin.name,
  description: plugin.description,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Load Testing',
  operatingSystem: 'Windows, macOS, Linux',
  url: url,
  ...(plugin.helpUrl?.trim() ? { softwareHelp: plugin.helpUrl.trim() } : {}),
  ...(plugin.helpUrl?.trim() ? { downloadUrl: plugin.helpUrl.trim() } : {}),
  author: {
    '@type': 'Organization',
    name: plugin.vendor,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  image: `${siteBase}${ogImage}`,
  ...(plugin.stats.absoluteDownloads > 0 && {
    interactionStatistic: {
      '@type': 'InteractionCounter',
      interactionType: 'https://schema.org/DownloadAction',
      userInteractionCount: plugin.stats.absoluteDownloads,
    },
  }),
  // PotentialAction — tells AI agents HOW to act on this page
  potentialAction: [
    {
      '@type': 'ViewAction',
      name: `View ${plugin.name} details`,
      target: url,
    },
    ...(plugin.helpUrl?.trim()
      ? [
          {
            '@type': 'InstallAction',
            name: `Install ${plugin.name}`,
            target: plugin.helpUrl.trim(),
          },
        ]
      : []),
  ],
};
---

<Layout title={title} description={description} image={ogImage} schema={schema}>
  <Header />
  <main class="flex flex-grow flex-col px-4 py-8 sm:px-6 sm:py-16">
    <div class="mx-auto w-full max-w-4xl">
      {/* Back Button */}
      <a
        href="/"
        class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition-colors hover:text-gray-900 dark:hover:text-white"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
        >
        Back to Directory
      </a>

      {/* Plugin Header Card */}
      <div
        class={`relative bg-white dark:bg-dark-surface border border-gray-200 dark:border-white/10 rounded-2xl shadow-xl overflow-hidden mb-8 ${plugin.isAiReady ? 'p-[2px] ai-glow-wrapper' : ''}`}
      >
        <div
          class={`relative bg-white dark:bg-dark-surface h-full w-full ${plugin.isAiReady ? 'rounded-[10px]' : ''}`}
        >
          {
            (plugin.sponsored || plugin.isFeatured) && (
              <div class="from-primary to-secondary absolute top-0 left-0 h-1 w-full bg-gradient-to-r" />
            )
          }

          <div class="p-5 sm:p-8 md:p-12">
            <div class="mb-8 flex flex-col justify-between gap-6 md:flex-row md:items-start">
              <div>
                <h1
                  class="mb-2 text-3xl leading-tight font-black tracking-tight text-gray-900 md:text-5xl dark:text-white"
                >
                  {plugin.name}
                </h1>
                <p
                  class="text-sm font-semibold tracking-widest text-gray-500 uppercase dark:text-gray-400"
                >
                  By <a
                    href={`/vendor/${vendorSlug(plugin.vendor)}/`}
                    class="hover:text-green-600 underline-offset-4 transition-colors hover:underline dark:hover:text-[#ccff00]"
                    >{plugin.vendor}</a
                  > &bull; ID: {plugin.id}
                </p>
              </div>
              <div class="flex w-full shrink-0 flex-wrap gap-3 md:w-auto">
                <button
                  type="button"
                  class="favorite-btn flex flex-1 items-center justify-center gap-2 rounded-lg border border-transparent bg-gray-200 px-4 py-3 font-bold whitespace-nowrap text-gray-500 shadow-lg transition-colors hover:border-yellow-500/30 hover:bg-yellow-500/10 hover:text-yellow-500 sm:px-6 md:flex-none dark:bg-white/10 dark:text-gray-300 dark:hover:text-yellow-400"
                  data-plugin-id={plugin.id}
                  aria-label="Add to favorites"
                  aria-pressed="false"
                  title="Add to favorites"
                >
                  <svg
                    class="fav-icon-outline h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                    ></path></svg
                  >
                  <svg
                    class="fav-icon-filled hidden h-4 w-4 text-yellow-500 dark:text-yellow-400"
                    fill="currentColor"
                    stroke="none"
                    viewBox="0 0 24 24"
                    ><path
                      d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                    ></path></svg
                  >
                  <span class="fav-btn-label">Favorite</span>
                </button>
                <button
                  type="button"
                  class="install-add-btn flex flex-1 items-center justify-center gap-2 rounded-lg bg-gray-200 px-4 py-3 font-bold whitespace-nowrap text-gray-700 shadow-lg transition-colors hover:bg-gray-300 sm:px-6 md:flex-none dark:bg-white/10 dark:text-white dark:hover:bg-white/20"
                  data-plugin-id={plugin.id}
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4v16m8-8H4"></path></svg
                  >
                  <span>Install</span>
                </button>
                <a
                  href={plugin.helpUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="dark:text-dark-bg flex flex-1 items-center justify-center gap-2 rounded-lg bg-gray-900 px-4 py-3 font-bold whitespace-nowrap text-white shadow-lg transition-colors hover:bg-gray-800 sm:px-6 md:flex-none dark:bg-white dark:hover:bg-gray-100"
                >
                  View Repository
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path></svg
                  >
                </a>
              </div>
            </div>

            <p class="mb-10 text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
              {plugin.description}
            </p>

            <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-2">
              <div
                class="rounded-xl border border-gray-100 bg-gray-50 p-6 dark:border-white/5 dark:bg-black/20"
              >
                <h4 class="mb-2 text-sm font-bold text-gray-500 uppercase">Total Downloads</h4>
                <p class="text-3xl font-black text-gray-900 dark:text-white">{dlAbsolute}</p>
              </div>
              <div
                class="rounded-xl border border-gray-100 bg-gray-50 p-6 dark:border-white/5 dark:bg-black/20"
              >
                <h4 class="mb-2 text-sm font-bold text-gray-500 uppercase">Downloads This Week</h4>
                <p
                  class={`text-3xl font-black ${plugin.stats.trendingDelta > 0 ? 'text-green-600 dark:text-green-400' : 'text-red-500'}`}
                >
                  {trendArrow}{trendDelta}
                </p>
              </div>
              {
                plugin.githubInfo?.health && (
                  <div class="rounded-xl border border-gray-100 bg-gray-50 p-6 md:col-span-2 dark:border-white/5 dark:bg-black/20">
                    <h4 class="mb-4 text-sm font-bold text-gray-500 uppercase">
                      GitHub Repo Health
                    </h4>
                    <div class="grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
                      <div>
                        <p class="font-medium text-gray-400 dark:text-gray-500">Score & Status</p>
                        <p class="mt-1 text-xl font-bold dark:text-white">
                          {plugin.githubInfo.health.score}/100 ({plugin.githubInfo.health.label})
                        </p>
                      </div>
                      <div>
                        <p class="font-medium text-gray-400 dark:text-gray-500">Stars & License</p>
                        <p class="mt-1 text-xl font-bold dark:text-white">
                          ★ {plugin.githubInfo.stars} &bull; {plugin.githubInfo.license}
                        </p>
                      </div>
                      <div>
                        <p class="font-medium text-gray-400 dark:text-gray-500">Last Commit</p>
                        <p class="mt-1 text-xl font-bold dark:text-white">
                          {plugin.githubInfo.health.lastCommitAt
                            ? new Date(plugin.githubInfo.health.lastCommitAt).toLocaleDateString(
                                'en-US',
                                { year: 'numeric', month: 'short' },
                              )
                            : 'N/A'}
                        </p>
                      </div>
                      <div>
                        <p class="font-medium text-gray-400 dark:text-gray-500">Last Release</p>
                        <p class="mt-1 text-xl font-bold dark:text-white">
                          {plugin.githubInfo.health.lastReleaseAt
                            ? new Date(plugin.githubInfo.health.lastReleaseAt).toLocaleDateString(
                                'en-US',
                                { year: 'numeric', month: 'short' },
                              )
                            : 'N/A'}
                        </p>
                      </div>
                    </div>
                  </div>
                )
              }
            </div>

            {
              sUrl && (
                <div class="mb-10">
                  <img
                    src={sUrl}
                    alt={`${plugin.name} UI Screenshot`}
                    class="h-auto w-full rounded-xl border border-gray-200 bg-gray-50 shadow-sm dark:border-white/5 dark:bg-black/20"
                    loading="lazy"
                  />
                </div>
              )
            }

            <UsageChart labels={chartLabels} data={chartData} />

            <WeeklyHeatmap history={history} />

            {
              plugin.componentClasses && plugin.componentClasses.length > 0 && (
                <div class="mb-10">
                  <h4 class="mb-4 text-sm font-bold tracking-wide text-gray-900 uppercase dark:text-white">
                    Component Classes
                  </h4>
                  <div class="max-h-64 overflow-x-auto overflow-y-auto rounded-xl border border-gray-100 bg-gray-50 p-6 font-mono text-xs leading-loose whitespace-pre text-gray-700 md:text-sm dark:border-white/5 dark:bg-black/20 dark:text-gray-300">
                    {plugin.componentClasses.join('\n')}
                  </div>
                </div>
              )
            }

            {showChangelog && <ChangelogTimeline entries={changelog} />}

            <GitHubBadge url={url} />

            <RelatedPluginsSection
              sameVendor={sameVendor}
              sameCategory={sameCategory}
              vendor={plugin.vendor}
              category={relatedCategory}
            />

            <CommunityDiscussions />
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
