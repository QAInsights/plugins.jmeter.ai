---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { sortPosts, filterDrafts, getReadingTime } from '../../../utils/blog';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const posts = filterDrafts(allPosts);
  const uniqueTags = [...new Set(posts.map((post) => post.data.tags || []).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = posts.filter((post) => post.data.tags?.includes(tag));
    return {
      params: { tag: tag },
      props: { posts: sortPosts(filteredPosts) },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout
  title={`${tag} - PerfAtlas Blog`}
  description={`Explore all blog posts tagged with ${tag}.`}
>
  <Header />
  <main class="mx-auto w-full max-w-7xl flex-grow px-6 py-12 md:py-20">
    <div class="mb-12 text-center md:text-left">
      <h1
        class="mb-4 text-4xl font-extrabold tracking-tight text-gray-900 md:text-5xl dark:text-white"
      >
        Topic: <span class="text-green-600 dark:text-[#ccff00]">{tag}</span>
      </h1>
      <p class="max-w-2xl text-xl text-gray-600 dark:text-gray-400">
        Showing all articles related to {tag}.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <article class="dark:bg-dark-surface hover:border-primary/50 dark:hover:border-primary/50 group flex w-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-white/10 dark:hover:shadow-[0_0_20px_rgba(204,255,0,0.15)]">
            <a href={`/blog/${post.id}/`} class="relative block aspect-video overflow-hidden">
              {post.data.image ? (
                <Image
                  src={post.data.image}
                  alt={post.data.imageAlt || post.data.title}
                  class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                  width={600}
                  height={338}
                  format="webp"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gray-100 dark:bg-white/5">
                  <span class="font-medium text-gray-400 dark:text-gray-600">No Image</span>
                </div>
              )}
            </a>
            <div class="flex flex-1 flex-col p-6">
              <div class="mb-3 flex items-center gap-3">
                <span class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-gray-400 uppercase dark:bg-white/5 dark:text-gray-500">
                  {getReadingTime(post.body || '')}
                </span>
              </div>
              <h2 class="group-hover:text-green-600 mb-3 text-xl leading-tight font-bold text-gray-900 transition-colors dark:text-gray-100 dark:group-hover:text-[#ccff00]">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="mb-6 line-clamp-3 text-sm text-gray-600 dark:text-gray-400">
                {post.data.description}
              </p>
              <a
                href={`/blog/${post.id}/`}
                class="group-hover:text-green-600 mt-auto flex items-center gap-1 text-sm font-bold text-gray-900 transition-colors dark:text-white dark:group-hover:text-[#ccff00]"
              >
                Read more →
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-20 text-center">
      <a href="/blog/tags/" class="font-bold text-green-600 hover:underline dark:text-[#ccff00]">
        View all topics →
      </a>
    </div>
  </main>
  <Footer />
</Layout>
