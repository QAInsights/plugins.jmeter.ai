---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import { sortPosts, filterDrafts, getReadingTime } from '../../utils/blog';
import Search from 'astro-pagefind/components/Search';
import placeholderImg from '../../assets/blog/placeholder.png';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection('blog');
  const posts = sortPosts(filterDrafts(allPosts));
  // We only want paths for 2, 3, 4... since index.astro handles page 1
  return paginate(posts, { pageSize: 6 }).filter((p) => p.params.page !== '1');
}

const { page } = Astro.props;
const posts = page.data;

// Get all unique tags for the sidebar
const allPosts = await getCollection('blog');
const allSortedPosts = sortPosts(filterDrafts(allPosts));
const uniqueTags = Array.from(new Set(allSortedPosts.flatMap((p) => p.data.tags || []))).slice(
  0,
  10,
);
---

<Layout
  title={`Blog - Page ${page.currentPage} - PerfAtlas`}
  description="Read the latest news and guides about JMeter plugins and performance testing."
>
  <Header />

  <!-- Hero Header with Grid -->
  <section class="dark:bg-dark-bg relative overflow-hidden border-b border-gray-200 bg-gray-50 pt-16 pb-24 dark:border-white/5">
    <div class="grid-background absolute inset-0 opacity-20"></div>
    <div class="dark:to-dark-bg/80 absolute inset-0 bg-gradient-to-b from-transparent"></div>

    <div class="relative mx-auto max-w-7xl px-6 text-center">
      <h1 class="mb-6 text-5xl font-black tracking-tighter text-gray-900 md:text-7xl dark:text-white">
        Blog <span
          class="bg-gradient-to-r from-green-500 to-green-600 bg-clip-text text-transparent dark:from-green-400 dark:to-[#ccff00]"
          >Archive</span
        >
      </h1>
      <p class="mx-auto max-w-2xl text-xl leading-relaxed text-gray-600 dark:text-gray-400">
        Page {page.currentPage} of {page.lastPage}. Browsing through our technical history.
      </p>
    </div>
  </section>

  <main class="mx-auto w-full max-w-7xl flex-grow px-6 py-16">
    <div class="flex flex-col gap-16 lg:flex-row">
      <!-- Sidebar -->
      <aside class="w-full shrink-0 lg:w-72">
        <div class="sticky top-24">
          <div class="sidebar-item">
            <h3
              class="mb-6 border-b border-gray-200 pb-2 text-xs font-bold tracking-widest text-gray-500 uppercase dark:border-white/10 dark:text-gray-400"
            >
              Search
            </h3>
            <Search id="search" className="pagefind-ui-custom" uiOptions={{ showImages: false }} />
          </div>

          <div class="sidebar-item">
            <h3
              class="mb-6 border-b border-gray-200 pb-2 text-xs font-bold tracking-widest text-gray-500 uppercase dark:border-white/10 dark:text-gray-400"
            >
              Popular Tags
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                uniqueTags.map((tag) => (
                  <a
                    href={`/blog/tags/${tag}/`}
                    class="rounded-full border border-gray-200 bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 lowercase transition-all hover:border-[#ccff00]/50 hover:text-gray-900 dark:border-white/10 dark:bg-white/5 dark:text-gray-400 dark:hover:text-white"
                  >
                    #{tag}
                  </a>
                ))
              }
            </div>
          </div>

          <div class="sidebar-item">
            <h3
              class="mb-6 border-b border-gray-200 pb-2 text-xs font-bold tracking-widest text-gray-500 uppercase dark:border-white/10 dark:text-gray-400"
            >
              Subscribe
            </h3>
            <p class="mb-6 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
              Stay up-to-date with the latest JMeter plugins and performance news.
            </p>
            <a
              href="/rss.xml"
              class="flex w-full items-center justify-center gap-2 rounded-lg bg-gray-900 px-4 py-2 font-bold text-white shadow-lg shadow-black/5 transition-colors hover:bg-[#ccff00] hover:text-black dark:bg-white dark:text-black dark:shadow-none dark:hover:bg-[#ccff00]"
            >
              RSS Feed
            </a>
          </div>
        </div>
      </aside>

      <!-- Main Feed -->
      <div class="flex-1">
        <div class="grid grid-cols-1 gap-12">
          {
            posts.map((post) => (
              <article class="group relative flex flex-col items-start gap-8 rounded-2xl border border-transparent p-4 transition-all duration-300 hover:border-gray-200 hover:bg-gray-50 md:flex-row dark:hover:border-white/10 dark:hover:bg-white/5">
                <a
                  href={`/blog/${post.id}/`}
                  class="relative aspect-video w-full shrink-0 overflow-hidden rounded-xl border border-gray-200 shadow-sm transition-shadow group-hover:shadow-md md:w-80 dark:border-white/10"
                >
                  <Image
                    src={post.data.image || placeholderImg}
                    alt={post.data.imageAlt || post.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    width={600}
                    height={338}
                    format="webp"
                  />
                </a>

                <div class="flex flex-1 flex-col pt-2">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="mb-4 block font-mono text-[11px] tracking-widest text-gray-500 uppercase dark:text-gray-400"
                  >
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                    <span class="mx-2 text-gray-300 dark:text-gray-800">•</span>
                    {getReadingTime(post.body || '')}
                  </time>

                  <h2 class="mb-4 text-2xl leading-tight font-bold text-gray-900 transition-colors group-hover:text-green-600 dark:text-white dark:group-hover:text-[#ccff00]">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>

                  <p class="mb-6 line-clamp-3 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                    {post.data.description}
                  </p>

                  <div class="mt-auto flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <div class="flex h-6 w-6 items-center justify-center rounded-full bg-[#ccff00] text-[10px] font-black text-black">
                        {post.data.author.charAt(0)}
                      </div>
                      <span class="text-xs font-medium text-gray-600 dark:text-gray-300">
                        {post.data.author}
                      </span>
                    </div>
                    <a
                      href={`/blog/${post.id}/`}
                      class="flex items-center gap-1 text-xs font-bold tracking-widest text-green-600 uppercase opacity-0 transition-all group-hover:opacity-100 dark:text-[#ccff00]"
                    >
                      Read Post{' '}
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                          d="M14 5l7 7m0 0l-7 7m7-7H3"
                        />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <!-- Pagination Controls -->
        <nav class="mt-16 flex items-center justify-center gap-4">
          {
            page.url.prev && (
              <a
                href={
                  page.url.prev === '/blog/1' || page.url.prev === '/blog/1/'
                    ? '/blog/'
                    : page.url.prev
                }
                class="rounded-xl border border-gray-200 px-6 py-3 text-sm font-bold text-gray-900 shadow-sm transition-all hover:bg-gray-100 hover:shadow-md dark:border-white/10 dark:text-white dark:hover:bg-white/5"
              >
                ← Previous
              </a>
            )
          }

          <span class="font-mono text-xs tracking-widest text-gray-500 uppercase">
            Page {page.currentPage} of {page.lastPage}
          </span>

          {
            page.url.next && (
              <a
                href={page.url.next}
                class="rounded-xl border border-gray-200 px-6 py-3 text-sm font-bold text-gray-900 shadow-sm transition-all hover:bg-gray-100 hover:shadow-md dark:border-white/10 dark:text-white dark:hover:bg-white/5"
              >
                Next →
              </a>
            )
          }
        </nav>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
