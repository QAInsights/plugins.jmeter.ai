---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import { getReadingTime, filterDrafts } from '../../utils/blog';
import TableOfContents from '../../components/TableOfContents.astro';
import placeholderImg from '../../assets/blog/placeholder.png';

import { type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const posts = filterDrafts(allPosts);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout
  title={`${post.data.title} - PerfAtlas Blog`}
  description={post.data.description}
  image={`/og/blog/${post.id}.png`}
  type="article"
  articleDate={post.data.pubDate.toISOString()}
  articleModifiedDate={post.data.updatedDate
    ? post.data.updatedDate.toISOString()
    : post.data.pubDate.toISOString()}
  articleAuthor={post.data.author}
>
  <Header />
  <main class="mx-auto w-full max-w-7xl flex-grow px-6 py-12 md:py-20">
    <div class="flex flex-col gap-12 overflow-visible md:flex-row">
      <!-- Sidebar TOC -->
      <aside class="relative z-20 order-2 hidden w-64 shrink-0 md:block">
        <div class="sticky top-28 h-fit">
          <div
            class="dark:bg-dark-surface group/sidebar relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-white/10"
          >
            <div
              class="bg-primary/5 group-hover/sidebar:bg-primary/10 absolute -top-4 -right-4 h-24 w-24 rounded-full blur-2xl transition-colors duration-500"
            >
            </div>

            <h4
              class="mb-4 flex items-center gap-2 text-sm font-bold text-gray-900 dark:text-white"
            >
              <svg
                class="text-primary h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                ><path
                  d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"
                ></path><circle cx="12" cy="12" r="3"></circle></svg
              >
              Agent Actions
            </h4>

            <!-- Primary Action: Copy for AI -->
            <button
              id="copyForAiBtn"
              data-url={Astro.url.href}
              data-title={post.data.title}
              class="bg-primary/10 hover:bg-primary/20 border-primary/30 text-primary-dark group/btn mb-4 flex w-full items-center justify-between rounded-xl border px-4 py-2.5 text-sm font-bold transition-all dark:text-[#ccff00]"
            >
              <span class="flex items-center gap-2">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
                  ></path></svg
                >
                Copy for AI
              </span>
              <span
                id="copyFeedback"
                class="bg-primary/20 rounded px-1.5 py-0.5 text-[10px] opacity-0 transition-opacity group-hover/btn:opacity-100"
                >PROMPT</span
              >
            </button>

            <div class="mb-6 space-y-1">
              <p
                class="mb-2 px-1 text-[10px] font-bold tracking-widest text-gray-400 uppercase dark:text-gray-500"
              >
                Discuss with...
              </p>

              <a
                href={`https://chatgpt.com/?q=${encodeURIComponent('Please summarize this JMeter guide: ' + Astro.url.href)}`}
                target="_blank"
                class="group/link flex items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-600 transition-colors hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5"
              >
                <span>ChatGPT</span>
                <svg
                  class="text-primary h-3.5 w-3.5 opacity-0 transition-opacity group-hover/link:opacity-100"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path></svg
                >
              </a>

              <a
                href={`https://claude.ai/new?q=${encodeURIComponent('I want to discuss this technical guide: ' + Astro.url.href)}`}
                target="_blank"
                class="group/link flex items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-600 transition-colors hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5"
              >
                <span>Claude</span>
                <svg
                  class="text-primary h-3.5 w-3.5 opacity-0 transition-opacity group-hover/link:opacity-100"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path></svg
                >
              </a>

              <a
                href={`https://www.perplexity.ai/search?q=${encodeURIComponent('Explain the key takeaways from ' + Astro.url.href)}`}
                target="_blank"
                class="group/link flex items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-600 transition-colors hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5"
              >
                <span>Perplexity</span>
                <svg
                  class="text-primary h-3.5 w-3.5 opacity-0 transition-opacity group-hover/link:opacity-100"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path></svg
                >
              </a>
            </div>

            <div class="border-t border-gray-100 pt-4 dark:border-white/5">
              <p
                class="mb-3 px-1 text-[10px] font-bold tracking-widest text-gray-400 uppercase dark:text-gray-500"
              >
                Share Post
              </p>
              <div class="flex gap-2 px-1">
                <a
                  href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  class="hover:border-primary/50 hover:text-primary rounded-lg border border-gray-200 bg-gray-50 p-2 text-gray-500 transition-all dark:border-white/10 dark:bg-white/5 dark:text-gray-400"
                >
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"
                    ><path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path></svg
                  >
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  class="hover:border-primary/50 hover:text-primary rounded-lg border border-gray-200 bg-gray-50 p-2 text-gray-500 transition-all dark:border-white/10 dark:bg-white/5 dark:text-gray-400"
                >
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"
                    ><path
                      d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                    ></path></svg
                  >
                </a>
                <a
                  href={`https://github.com/QAInsights/plugins.jmeter.ai/blob/main/src/content/blog/${post.id}.md`}
                  target="_blank"
                  title="View Markdown Source"
                  class="hover:border-primary/50 hover:text-primary rounded-lg border border-gray-200 bg-gray-50 p-2 text-gray-500 transition-all dark:border-white/10 dark:bg-white/5 dark:text-gray-400"
                >
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"
                    ><path
                      d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.472-4.041-1.472-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                    ></path></svg
                  >
                </a>
              </div>
            </div>
          </div>

          <div class="mt-12">
            <TableOfContents headings={headings} />
          </div>

          <a
            href="/blog/"
            class="mt-8 flex items-center justify-center gap-2 rounded-xl border border-gray-200 px-4 py-3 text-xs font-bold tracking-widest text-gray-500 uppercase transition-all hover:text-green-600 dark:border-white/10 dark:hover:text-[#ccff00]"
          >
            &larr; All Posts
          </a>
        </div>
      </aside>

      <!-- Article Body -->
      <article class="order-1 min-w-0 flex-1" data-pagefind-body>
        <header class="mb-10 text-center">
          <div class="mb-6 flex items-center justify-center gap-3">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-sm font-medium text-gray-500 dark:text-gray-400"
            >
              {
                post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
            <span class="text-gray-300 dark:text-gray-700">&bull;</span>
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
              {post.data.author}
            </span>
            <span class="text-gray-300 dark:text-gray-700">&bull;</span>
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
              {getReadingTime(post.body || '')}
            </span>
            {
              post.data.draft && (
                <>
                  <span class="text-gray-300 dark:text-gray-700">&bull;</span>
                  <span class="rounded-md border border-yellow-200 bg-yellow-50 px-2 py-0.5 text-[10px] font-bold tracking-wider text-yellow-700 uppercase dark:border-yellow-500/30 dark:bg-yellow-900/30 dark:text-yellow-400">
                    Draft
                  </span>
                </>
              )
            }
          </div>

          <h1
            class="mb-6 text-3xl leading-tight font-extrabold tracking-tight text-gray-900 md:text-5xl lg:text-5xl dark:text-white"
          >
            {post.data.title}
          </h1>

          {
            post.data.tags && post.data.tags.length > 0 && (
              <div class="mb-8 flex flex-wrap items-center justify-center gap-2">
                {post.data.tags.map((tag: string) => (
                  <span class="rounded-full bg-green-50 px-3 py-1 text-sm font-semibold text-green-700 dark:bg-[#ccff00]/10 dark:text-[#ccff00]">
                    {tag}
                  </span>
                ))}
              </div>
            )
          }

          <div
            class="mb-12 overflow-hidden rounded-2xl border border-gray-100 shadow-xl dark:border-white/5"
          >
            <Image
              src={post.data.image || placeholderImg}
              alt={post.data.imageAlt || post.data.title}
              class="h-auto max-h-[500px] w-full object-cover"
              width={1200}
              height={675}
              format="webp"
            />
          </div>
        </header>

        <!-- Mobile TOC -->
        <div
          class="mb-12 rounded-2xl border border-gray-200 bg-gray-50 p-6 md:hidden dark:border-white/10 dark:bg-white/5"
        >
          <TableOfContents headings={headings} isMobile={true} />
        </div>

        <div
          class="prose prose-lg dark:prose-invert prose-green prose-headings:font-bold prose-a:text-green-600 dark:prose-a:text-[#ccff00] hover:prose-a:text-green-500 prose-img:rounded-xl prose-img:shadow-lg max-w-none"
        >
          <Content />
        </div>

        <footer
          class="mt-16 flex items-center justify-between border-t border-gray-200 pt-8 dark:border-white/10"
        >
          <a
            href="/"
            class="font-medium transition-colors hover:text-green-600 dark:hover:text-[#ccff00]"
          >
            Home
          </a>
          <a
            href="/blog/"
            class="border-b-2 border-green-600 font-bold text-gray-900 transition-colors hover:text-green-600 dark:border-[#ccff00] dark:text-white dark:hover:text-[#ccff00]"
          >
            Blog
          </a>
          <a
            href="https://github.com/QAInsights/plugins.jmeter.ai/issues/new"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-gray-500 transition-colors hover:text-gray-900 dark:hover:text-white"
          >
            Suggest an Edit
          </a>
        </footer>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copyForAiBtn');
    const feedback = document.getElementById('copyFeedback');

    if (copyBtn && feedback) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url');
        const title = copyBtn.getAttribute('data-title');
        const prompt = `Please read and summarize this technical guide from PerfAtlas: "${title}" (${url}). Focus on the key JMeter plugins mentioned and the implementation steps.`;

        try {
          await navigator.clipboard.writeText(prompt);

          // Visual feedback
          const originalText = feedback.textContent;
          feedback.textContent = 'COPIED!';
          feedback.classList.remove('bg-primary/20');
          feedback.classList.add('bg-green-500', 'text-white', 'opacity-100');
          copyBtn.classList.add('border-green-500/50', 'bg-green-500/10');

          setTimeout(() => {
            feedback.textContent = originalText;
            feedback.classList.add('bg-primary/20');
            feedback.classList.remove('bg-green-500', 'text-white', 'opacity-100');
            copyBtn.classList.remove('border-green-500/50', 'bg-green-500/10');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy: ', err);
        }
      });
    }
  });
</script>
