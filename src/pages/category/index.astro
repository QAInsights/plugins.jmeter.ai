---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import pluginsData from '../../data/plugins_data.json';
import { getCategorySummaries } from '../../utils/programmaticSeo';
import { buildItemListSchema } from '../../utils/seoSchema';

const categories = getCategorySummaries(pluginsData);
const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);

const itemListSchema = buildItemListSchema(
  'Apache JMeter Plugin Categories',
  categories.map((c) => ({
    name: c.title,
    url: `/category/${c.slug}/`,
    description: c.intro,
  })),
);
---

<Layout
  title="JMeter Plugin Categories | PerfAtlas"
  description="Browse 150+ Apache JMeter plugins by category: Listeners, Samplers, Timers, Configs, Assertions, Processors, and Thread Groups."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Categories', url: '/category/' },
  ]}
  schema={itemListSchema}
>
  <Header />
  <main class="mx-auto w-full max-w-7xl flex-grow px-4 py-12 sm:px-6 md:py-20">
    <div class="mb-12">
      <p class="mb-3 text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400">
        Directory Taxonomy
      </p>
      <h1
        class="mb-4 text-4xl font-black tracking-tighter text-gray-900 md:text-6xl dark:text-white"
      >
        JMeter Plugin <span
          class="bg-gradient-to-r from-green-500 to-green-600 bg-clip-text text-transparent dark:from-green-400 dark:to-[#ccff00]"
          >Categories</span
        >
      </h1>
      <p class="max-w-2xl text-xl text-gray-600 dark:text-gray-400">
        Explore Apache JMeter extensions grouped by component type, ranked by total downloads.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat) => (
          <a
            href={`/category/${cat.slug}/`}
            class="dark:bg-dark-surface group flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-green-500/50 hover:shadow-lg dark:border-white/10"
          >
            <div class="mb-3 flex items-center justify-between gap-2">
              <h2 class="text-xl font-black text-gray-900 group-hover:text-green-600 dark:text-white dark:group-hover:text-[#ccff00]">
                {cat.headline}
              </h2>
              <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-bold text-gray-600 dark:bg-white/10 dark:text-gray-300">
                {cat.pluginCount}
              </span>
            </div>
            <p class="mb-6 flex-grow text-sm leading-relaxed text-gray-600 dark:text-gray-400">
              {cat.intro}
            </p>
            <div class="flex items-center justify-between border-t border-gray-100 pt-4 text-xs font-semibold text-gray-500 dark:border-white/10 dark:text-gray-400">
              <span>{fmt(cat.totalDownloads)} total downloads</span>
              <span class="text-green-600 dark:text-[#ccff00]">Explore →</span>
            </div>
          </a>
        ))
      }
    </div>
  </main>
  <Footer />
</Layout>
