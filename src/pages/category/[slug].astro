---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PluginCard from '../../components/PluginCard.astro';
import PluginModal from '../../components/PluginModal.astro';
import pluginsData from '../../data/plugins_data.json';
import { getCategorySummaries } from '../../utils/programmaticSeo';
import { buildFaqSchema, buildItemListSchema } from '../../utils/seoSchema';

export function getStaticPaths() {
  const summaries = getCategorySummaries(pluginsData);
  return summaries.map((summary) => ({
    params: { slug: summary.slug },
    props: { summary },
  }));
}

const { summary } = Astro.props;
const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Categories', url: '/category/' },
  { name: summary.headline, url: `/category/${summary.slug}/` },
];

const itemListSchema = buildItemListSchema(
  summary.title,
  summary.plugins.slice(0, 30).map((p) => ({
    name: p.name,
    url: `/plugin/${p.id}/`,
    description: p.description,
  })),
);

const faqSchema = buildFaqSchema(summary.faqs);
---

<Layout
  title={`${summary.title} (${summary.pluginCount}) | PerfAtlas`}
  description={`${summary.intro} Compare ${summary.pluginCount} plugins with ${fmt(summary.totalDownloads)} combined downloads.`}
  breadcrumbs={breadcrumbs}
  schema={[itemListSchema, faqSchema]}
>
  <Header />
  <main class="mx-auto w-full max-w-7xl flex-grow px-4 py-12 sm:px-6 md:py-16">
    <nav
      aria-label="Breadcrumb"
      class="mb-8 flex flex-wrap items-center gap-2 text-sm font-semibold text-gray-500 dark:text-gray-400"
    >
      <a href="/" class="hover:text-gray-900 dark:hover:text-white">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/category/" class="hover:text-gray-900 dark:hover:text-white">Categories</a>
      <span aria-hidden="true">/</span>
      <span class="text-gray-900 dark:text-white" aria-current="page">{summary.headline}</span>
    </nav>

    <div class="mb-12">
      <p class="mb-3 text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400">
        {summary.pluginCount} Plugins &bull; {fmt(summary.totalDownloads)} Total Downloads
      </p>
      <h1
        class="mb-4 text-4xl font-black tracking-tighter text-gray-900 md:text-6xl dark:text-white"
      >
        {summary.title}
      </h1>
      <p class="max-w-3xl text-lg leading-relaxed text-gray-600 dark:text-gray-400">
        {summary.intro}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {summary.plugins.map((plugin) => <PluginCard plugin={plugin} />)}
    </div>

    {
      summary.faqs.length > 0 && (
        <section class="mx-auto mt-16 max-w-4xl border-t border-gray-200 pt-12 dark:border-white/10">
          <h2 class="mb-6 text-2xl font-black tracking-tight text-gray-900 dark:text-white">
            Frequently Asked Questions
          </h2>
          <div class="space-y-3">
            {summary.faqs.map((faq) => (
              <details class="dark:bg-dark-surface rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10">
                <summary class="cursor-pointer text-sm font-bold text-gray-900 dark:text-white">
                  {faq.question}
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </section>
      )
    }
  </main>
  <Footer />
  <PluginModal />
</Layout>
