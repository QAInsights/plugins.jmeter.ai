---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import pluginsData from '../../data/plugins_data.json';
import { vendorSlug } from '../../utils/plugin';
import { categoryToSlug, getTopComparisonPairs } from '../../utils/programmaticSeo';
import { buildFaqSchema } from '../../utils/seoSchema';

export function getStaticPaths() {
  const pairs = getTopComparisonPairs(pluginsData, 30);
  return pairs.map((pair) => ({
    params: { pair: pair.slug },
    props: { pair },
  }));
}

const { pair } = Astro.props;
const { pluginA, pluginB, category } = pair;
const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);

const dlA = pluginA.stats?.absoluteDownloads ?? 0;
const dlB = pluginB.stats?.absoluteDownloads ?? 0;
const morePopular = dlA >= dlB ? pluginA : pluginB;

const faqs = [
  {
    question: `Which is more popular: ${pluginA.name} or ${pluginB.name}?`,
    answer: `${morePopular.name} (${morePopular.id}) has more total downloads (${fmt(morePopular.stats?.absoluteDownloads ?? 0)}), compared to ${fmt(Math.min(dlA, dlB))} for ${morePopular.id === pluginA.id ? pluginB.name : pluginA.name}.`,
  },
  {
    question: `Can I install both ${pluginA.name} and ${pluginB.name} together?`,
    answer: `Yes. Install both in one command with PluginsManagerCMD.sh install ${pluginA.id},${pluginB.id}.`,
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: `${pluginA.name} vs ${pluginB.name}`, url: `/compare/${pair.slug}/` },
];
---

<Layout
  title={`${pluginA.name} vs ${pluginB.name} | JMeter Plugin Comparison`}
  description={`Side-by-side JMeter comparison: ${pluginA.name} (${fmt(dlA)} downloads) vs ${pluginB.name} (${fmt(dlB)} downloads). Compare health scores, compatibility, and CLI install commands.`}
  breadcrumbs={breadcrumbs}
  schema={buildFaqSchema(faqs)}
>
  <Header />
  <main class="mx-auto w-full max-w-5xl flex-grow px-4 py-12 sm:px-6 md:py-16">
    <nav
      aria-label="Breadcrumb"
      class="mb-8 flex flex-wrap items-center gap-2 text-sm font-semibold text-gray-500 dark:text-gray-400"
    >
      <a href="/" class="hover:text-gray-900 dark:hover:text-white">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/compare/" class="hover:text-gray-900 dark:hover:text-white">Compare</a>
      <span aria-hidden="true">/</span>
      <span class="text-gray-900 dark:text-white" aria-current="page">
        {pluginA.name} vs {pluginB.name}
      </span>
    </nav>

    <div class="mb-10">
      <p class="mb-3 text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400">
        JMeter {category} Comparison
      </p>
      <h1
        class="mb-4 text-3xl font-black tracking-tighter text-gray-900 md:text-5xl dark:text-white"
      >
        {pluginA.name}
        <span class="text-green-600 dark:text-[#ccff00]">vs</span>
        {pluginB.name}
      </h1>
      <p class="max-w-3xl text-lg text-gray-600 dark:text-gray-400">
        Direct comparison of two popular Apache JMeter plugins in <a
          href={`/category/${categoryToSlug(category)}/`}
          class="font-semibold text-green-600 hover:underline dark:text-[#ccff00]">{category}</a
        >.
      </p>
    </div>

    <div
      class="dark:bg-dark-surface mb-12 overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-white/10"
    >
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 dark:border-white/10 dark:bg-white/[0.02]">
            <th class="p-4 font-bold text-gray-500 uppercase">Metric</th>
            <th class="p-4 font-black text-gray-900 dark:text-white">
              <a
                href={`/plugin/${pluginA.id}/`}
                class="hover:text-green-600 dark:hover:text-[#ccff00]">{pluginA.name}</a
              >
            </th>
            <th class="p-4 font-black text-gray-900 dark:text-white">
              <a
                href={`/plugin/${pluginB.id}/`}
                class="hover:text-green-600 dark:hover:text-[#ccff00]">{pluginB.name}</a
              >
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-white/5">
          <tr>
            <td class="p-4 font-semibold text-gray-700 dark:text-gray-300">Plugin ID</td>
            <td class="p-4 font-mono text-xs text-gray-600 dark:text-gray-400">{pluginA.id}</td>
            <td class="p-4 font-mono text-xs text-gray-600 dark:text-gray-400">{pluginB.id}</td>
          </tr>
          <tr>
            <td class="p-4 font-semibold text-gray-700 dark:text-gray-300">Vendor</td>
            <td class="p-4">
              <a
                href={`/vendor/${vendorSlug(pluginA.vendor)}/`}
                class="text-green-600 hover:underline dark:text-[#ccff00]">{pluginA.vendor}</a
              >
            </td>
            <td class="p-4">
              <a
                href={`/vendor/${vendorSlug(pluginB.vendor)}/`}
                class="text-green-600 hover:underline dark:text-[#ccff00]">{pluginB.vendor}</a
              >
            </td>
          </tr>
          <tr>
            <td class="p-4 font-semibold text-gray-700 dark:text-gray-300">Total Downloads</td>
            <td class="p-4 font-bold text-gray-900 dark:text-white">{fmt(dlA)}</td>
            <td class="p-4 font-bold text-gray-900 dark:text-white">{fmt(dlB)}</td>
          </tr>
          <tr>
            <td class="p-4 font-semibold text-gray-700 dark:text-gray-300">Weekly Trend</td>
            <td class="p-4 text-gray-700 dark:text-gray-300">
              {(pluginA.stats?.trendingDelta ?? 0) > 0 ? '+' : ''}
              {fmt(pluginA.stats?.trendingDelta ?? 0)}
            </td>
            <td class="p-4 text-gray-700 dark:text-gray-300">
              {(pluginB.stats?.trendingDelta ?? 0) > 0 ? '+' : ''}
              {fmt(pluginB.stats?.trendingDelta ?? 0)}
            </td>
          </tr>
          <tr>
            <td class="p-4 font-semibold text-gray-700 dark:text-gray-300">Repo Health</td>
            <td class="p-4 text-gray-700 dark:text-gray-300">
              {
                pluginA.githubInfo?.health
                  ? `${pluginA.githubInfo.health.score}/100 (${pluginA.githubInfo.health.label})`
                  : 'N/A'
              }
            </td>
            <td class="p-4 text-gray-700 dark:text-gray-300">
              {
                pluginB.githubInfo?.health
                  ? `${pluginB.githubInfo.health.score}/100 (${pluginB.githubInfo.health.label})`
                  : 'N/A'
              }
            </td>
          </tr>
          <tr>
            <td class="p-4 font-semibold text-gray-700 dark:text-gray-300">License</td>
            <td class="p-4 text-gray-700 dark:text-gray-300">
              {pluginA.githubInfo?.license || 'N/A'}
            </td>
            <td class="p-4 text-gray-700 dark:text-gray-300">
              {pluginB.githubInfo?.license || 'N/A'}
            </td>
          </tr>
          <tr>
            <td class="p-4 font-semibold text-gray-700 dark:text-gray-300">CLI Install</td>
            <td class="p-4 font-mono text-xs text-gray-700 dark:text-gray-300">
              PluginsManagerCMD.sh install {pluginA.id}
            </td>
            <td class="p-4 font-mono text-xs text-gray-700 dark:text-gray-300">
              PluginsManagerCMD.sh install {pluginB.id}
            </td>
          </tr>
          <tr>
            <td class="p-4 font-semibold text-gray-700 dark:text-gray-300">Summary</td>
            <td class="p-4 text-gray-600 dark:text-gray-400">{pluginA.description}</td>
            <td class="p-4 text-gray-600 dark:text-gray-400">{pluginB.description}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mb-12 flex flex-wrap gap-3">
      <a
        href={`/compare/?ids=${encodeURIComponent(`${pluginA.id},${pluginB.id}`)}`}
        class="rounded-xl bg-gray-900 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-green-600 dark:bg-white dark:text-black dark:hover:bg-[#ccff00]"
      >
        Open in Interactive Compare →
      </a>
      <a
        href={`/tools/cli-builder/?plugins=${encodeURIComponent(`${pluginA.id},${pluginB.id}`)}`}
        class="rounded-xl border border-gray-200 px-5 py-3 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-50 dark:border-white/10 dark:text-gray-300 dark:hover:bg-white/5"
      >
        Install Both in CLI Builder
      </a>
    </div>

    <section class="border-t border-gray-200 pt-10 dark:border-white/10">
      <h2 class="mb-5 text-2xl font-black tracking-tight text-gray-900 dark:text-white">
        Frequently Asked Questions
      </h2>
      <div class="space-y-3">
        {
          faqs.map((faq) => (
            <details class="dark:bg-dark-surface rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10">
              <summary class="cursor-pointer text-sm font-bold text-gray-900 dark:text-white">
                {faq.question}
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
