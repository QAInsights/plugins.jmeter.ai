    }

    .theme-check {
      position: absolute;
      top: 0.375rem;
      right: 0.375rem;
      width: 1.125rem;
      height: 1.125rem;
      color: #16a34a;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .theme-tile.is-active .theme-check {
      opacity: 1;
    }
    :global(.dark) .theme-check {
      color: #ccff00;
    }

    .theme-tile-label {
      font-size: 0.8125rem;
      font-weight: 600;
      color: #374151;
      text-align: center;
    }
    :global(.dark) .theme-tile-label {
      color: #d1d5db;
    }

    /* Mini UI previews */
    .theme-preview {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      height: 3.25rem;
      border-radius: 0.5rem;
      padding: 0.375rem;
      overflow: hidden;
    }
    .pv-bar {
      height: 0.375rem;
      width: 45%;
      border-radius: 999px;
    }
    .pv-line {
      height: 0.25rem;
      width: 100%;
      border-radius: 999px;
    }
    .pv-short {
      width: 70%;
    }
    .pv-light {
      background: linear-gradient(180deg, #ffffff, #f3f4f6);
      border: 1px solid #e5e7eb;
    }
    .pv-light .pv-bar {
      background: #16a34a;
    }
    .pv-light .pv-line {
      background: #d1d5db;
    }
    .pv-dark {
      background: linear-gradient(180deg, #18181b, #27272a);
      border: 1px solid rgb(255 255 255 / 0.1);
    }
    .pv-dark .pv-bar {
      background: #ccff00;
    }
    .pv-dark .pv-line {
      background: rgb(255 255 255 / 0.2);
    }
    .pv-system {
      background: linear-gradient(135deg, #ffffff 50%, #18181b 50%);
      border: 1px solid #e5e7eb;
    }
    .pv-system .pv-bar {
      background: linear-gradient(90deg, #16a34a 50%, #ccff00 50%);
    }
    .pv-system .pv-line {
      background: linear-gradient(90deg, #d1d5db 50%, rgb(255 255 255 / 0.25) 50%);
    }

    /* Arm-to-confirm state */
    .confirm-btn.armed {
      background: #dc2626 !important;
      border-color: #dc2626 !important;
      color: #fff !important;
    }

    /* Saved toast visibility */
    #savedToast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  </style>
</Layout>
