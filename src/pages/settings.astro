---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SignOutButton } from '@clerk/astro/components';
import { THEME_OPTIONS, CATEGORY_OPTIONS, SORT_OPTIONS } from '../utils/preferences';
---

<Layout
  title="Settings | PerfAtlas"
  description="Manage your PerfAtlas account settings and preferences."
>
  <Header />

  <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-10 sm:px-6 sm:py-12">
    <!-- Page header -->
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Settings</h1>
      <p class="text-gray-600 dark:text-gray-400">
        Preferences are saved to this browser and applied across the site.
      </p>
    </div>

    <div class="space-y-6">
      <!-- ============ Profile (auth-gated) ============ -->
      <section
        class="dark:bg-dark-surface overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-white/10"
      >
        <div class="flex items-start gap-3 border-b border-gray-100 px-6 py-5 dark:border-white/5">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-violet-100 dark:bg-violet-900/30"
          >
            <svg
              class="h-5 w-5 text-violet-600 dark:text-violet-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Profile</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">Your account and identity</p>
          </div>
        </div>

        <div class="px-6 py-6">
          <!-- Loading -->
          <div id="profile-loading" class="flex animate-pulse items-center gap-4">
            <div class="h-14 w-14 rounded-full bg-gray-200 dark:bg-white/10"></div>
            <div class="space-y-2">
              <div class="h-4 w-40 rounded bg-gray-200 dark:bg-white/10"></div>
              <div class="h-3 w-56 rounded bg-gray-200 dark:bg-white/10"></div>
            </div>
          </div>

          <!-- Signed out -->
          <div id="profile-signed-out" class="hidden">
            <div
              class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
            >
              <div>
                <p class="font-medium text-gray-900 dark:text-white">You're browsing as a guest</p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  Sign in to manage your account details.
                </p>
              </div>
              <button
                id="settingsSignInBtn"
                class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-green-600 px-5 py-2.5 text-sm font-semibold text-white transition-all hover:scale-[1.03] hover:bg-green-700 dark:bg-[#ccff00] dark:text-black dark:hover:bg-[#b8e600]"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"
                  ></path>
                </svg>
                Sign In
              </button>
            </div>
          </div>

          <!-- Signed in -->
          <div id="profile-signed-in" class="hidden">
            <div
              class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="flex items-center gap-4">
                <img
                  id="profileAvatar"
                  class="h-14 w-14 rounded-full border border-gray-200 bg-gray-100 object-cover dark:border-white/10 dark:bg-white/5"
                  src=""
                  alt="User avatar"
                />
                <div>
                  <p id="profileName" class="font-semibold text-gray-900 dark:text-white"></p>
                  <p id="profileEmail" class="text-sm text-gray-500 dark:text-gray-400"></p>
                </div>
              </div>
              <div class="flex flex-wrap gap-2">
                <button
                  id="manageAccountBtn"
                  class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-white/10 dark:bg-white/5 dark:text-gray-200 dark:hover:bg-white/10"
                >
                  Manage account
                </button>
                <SignOutButton asChild>
                  <button
                    class="inline-flex items-center gap-2 rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-600 transition-colors hover:bg-red-50 dark:border-red-900/40 dark:bg-transparent dark:text-red-400 dark:hover:bg-red-900/20"
                  >
                    Sign out
                  </button>
                </SignOutButton>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ Appearance ============ -->
      <section
        class="dark:bg-dark-surface overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-white/10"
      >
        <div class="flex items-start gap-3 border-b border-gray-100 px-6 py-5 dark:border-white/5">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-900/30"
          >
            <svg
              class="h-5 w-5 text-amber-600 dark:text-amber-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Appearance</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              Choose how PerfAtlas looks. System follows your device.
            </p>
          </div>
        </div>

        <div class="px-6 py-6">
          <div class="grid grid-cols-3 gap-3">
            {
              THEME_OPTIONS.map((opt) => (
                <button
                  class="theme-tile group"
                  data-theme={opt.value}
                  aria-pressed="false"
                  type="button"
                >
                  <span class={`theme-preview pv-${opt.value}`}>
                    <span class="pv-bar" />
                    <span class="pv-line" />
                    <span class="pv-line pv-short" />
                  </span>
                  <span class="theme-tile-label">{opt.label}</span>
                  <svg class="theme-check" viewBox="0 0 20 20" fill="currentColor">
                    <path
                      fill-rule="evenodd"
                      d="M16.704 5.29a1 1 0 010 1.415l-7.5 7.5a1 1 0 01-1.415 0l-3.5-3.5a1 1 0 111.415-1.415l2.792 2.793 6.793-6.793a1 1 0 011.415 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ============ Discovery defaults ============ -->
      <section
        class="dark:bg-dark-surface overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-white/10"
      >
        <div class="flex items-start gap-3 border-b border-gray-100 px-6 py-5 dark:border-white/5">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-100 dark:bg-sky-900/30"
          >
            <svg
              class="h-5 w-5 text-sky-600 dark:text-sky-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
              ></path>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Discovery defaults</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              Applied automatically when you open the plugin directory.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-5 px-6 py-6 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold text-gray-700 dark:text-gray-300"
              >Default category</span
            >
            <select id="defaultCategory" class="settings-select">
              {CATEGORY_OPTIONS.map((opt) => <option value={opt.value}>{opt.label}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold text-gray-700 dark:text-gray-300"
              >Default sort order</span
            >
            <select id="defaultSort" class="settings-select">
              {SORT_OPTIONS.map((opt) => <option value={opt.value}>{opt.label}</option>)}
            </select>
          </label>
        </div>
      </section>

      <!-- ============ Favorites ============ -->
      <section
        class="dark:bg-dark-surface overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-white/10"
      >
        <div class="flex items-start gap-3 border-b border-gray-100 px-6 py-5 dark:border-white/5">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-yellow-100 dark:bg-yellow-900/30"
          >
            <svg
              class="h-5 w-5 text-yellow-500 dark:text-yellow-400"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
              ></path>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Favorites</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              <span id="favCount" class="font-bold text-gray-900 dark:text-white">0</span> plugins saved
              on this device.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 px-6 py-6">
          <button
            id="favShareBtn"
            class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-white/10 dark:bg-white/5 dark:text-gray-200 dark:hover:bg-white/10"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-7.328a4 4 0 015.656 5.656l-1.5 1.5"
              ></path>
            </svg>
            <span class="btn-label">Copy share link</span>
          </button>
          <button
            id="favClearBtn"
            class="confirm-btn inline-flex items-center gap-2 rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-600 transition-colors hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-red-900/40 dark:bg-transparent dark:text-red-400 dark:hover:bg-red-900/20"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
              ></path>
            </svg>
            <span class="btn-label">Clear favorites</span>
          </button>
        </div>
      </section>

      <!-- ============ Data & privacy ============ -->
      <section
        class="dark:bg-dark-surface overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-white/10"
      >
        <div class="flex items-start gap-3 border-b border-gray-100 px-6 py-5 dark:border-white/5">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-900/30"
          >
            <svg
              class="h-5 w-5 text-emerald-600 dark:text-emerald-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Data &amp; privacy</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              Everything is stored locally in your browser. Export or erase it anytime.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 px-6 py-6">
          <button
            id="exportDataBtn"
            class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-white/10 dark:bg-white/5 dark:text-gray-200 dark:hover:bg-white/10"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span class="btn-label">Export my data</span>
          </button>
          <button
            id="resetPrefsBtn"
            class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-white/10 dark:bg-white/5 dark:text-gray-200 dark:hover:bg-white/10"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path>
            </svg>
            <span class="btn-label">Reset preferences</span>
          </button>
          <button
            id="clearAllBtn"
            class="confirm-btn inline-flex items-center gap-2 rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-600 transition-colors hover:bg-red-50 dark:border-red-900/40 dark:bg-transparent dark:text-red-400 dark:hover:bg-red-900/20"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
              ></path>
            </svg>
            <span class="btn-label">Clear all local data</span>
          </button>
        </div>
      </section>
    </div>
  </main>

  <!-- Saved toast -->
  <div
    id="savedToast"
    class="fixed bottom-6 left-1/2 z-[200] flex -translate-x-1/2 translate-y-4 items-center gap-2 rounded-full bg-gray-900 px-4 py-2 text-sm font-semibold text-white opacity-0 shadow-xl transition-all duration-200 dark:bg-[#ccff00] dark:text-black"
    role="status"
    aria-live="polite"
  >
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"
      ></path>
    </svg>
    Saved
  </div>

  <Footer />

  <script>
    import { $userStore, $clerkStore } from '@clerk/astro/client';
    import { PREFS_STORAGE_KEY } from '../utils/preferences';

    const prefsApi = () => (window as any).__preferences;
    const favsApi = () => (window as any).__favorites;

    /* ---------- Saved toast ---------- */
    const savedToast = document.getElementById('savedToast');
    let savedTimer: number;
    function flashSaved() {
      if (!savedToast) return;
      savedToast.classList.add('show');
      window.clearTimeout(savedTimer);
      savedTimer = window.setTimeout(() => savedToast.classList.remove('show'), 1400);
    }

    /* ---------- Profile (auth-gated) ---------- */
    const profileLoading = document.getElementById('profile-loading');
    const profileSignedOut = document.getElementById('profile-signed-out');
    const profileSignedIn = document.getElementById('profile-signed-in');
    const avatarEl = document.getElementById('profileAvatar') as HTMLImageElement | null;
    const nameEl = document.getElementById('profileName');
    const emailEl = document.getElementById('profileEmail');

    function renderProfile() {
      const clerk = $clerkStore.get();
      const user = $userStore.get();
      if (!clerk) {
        profileLoading?.classList.remove('hidden');
        profileSignedOut?.classList.add('hidden');
        profileSignedIn?.classList.add('hidden');
        return;
      }
      profileLoading?.classList.add('hidden');
      if (user) {
        profileSignedOut?.classList.add('hidden');
        profileSignedIn?.classList.remove('hidden');
        if (avatarEl) avatarEl.src = user.imageUrl || '';
        if (nameEl) nameEl.textContent = user.fullName || user.username || 'User';
        if (emailEl) emailEl.textContent = user.primaryEmailAddress?.emailAddress || '';
      } else {
        profileSignedOut?.classList.remove('hidden');
        profileSignedIn?.classList.add('hidden');
      }
    }
    $userStore.subscribe(renderProfile);
    $clerkStore.subscribe(renderProfile);
    renderProfile();

    document.getElementById('manageAccountBtn')?.addEventListener('click', () => {
      $clerkStore.get()?.openUserProfile();
    });
    document.getElementById('settingsSignInBtn')?.addEventListener('click', () => {
      $clerkStore.get()?.openSignIn();
    });

    /* ---------- Appearance: theme tiles ---------- */
    const themeTiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.theme-tile'));
    function syncThemeTiles() {
      const current = prefsApi()?.get().theme;
      themeTiles.forEach((tile) => {
        const active = tile.dataset.theme === current;
        tile.classList.toggle('is-active', active);
        tile.setAttribute('aria-pressed', String(active));
      });
    }
    themeTiles.forEach((tile) => {
      tile.addEventListener('click', () => prefsApi()?.set({ theme: tile.dataset.theme }));
    });

    /* ---------- Discovery defaults ---------- */
    const categorySelect = document.getElementById('defaultCategory') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('defaultSort') as HTMLSelectElement | null;
    function syncDefaults() {
      const p = prefsApi()?.get();
      if (!p) return;
      if (categorySelect) categorySelect.value = p.defaultCategory;
      if (sortSelect) sortSelect.value = p.defaultSort;
    }
    categorySelect?.addEventListener('change', () =>
      prefsApi()?.set({ defaultCategory: categorySelect.value }),
    );
    sortSelect?.addEventListener('change', () =>
      prefsApi()?.set({ defaultSort: sortSelect.value }),
    );

    /* ---------- Favorites ---------- */
    const favCountEl = document.getElementById('favCount');
    const favShareBtn = document.getElementById('favShareBtn') as HTMLButtonElement | null;
    const favClearBtn = document.getElementById('favClearBtn') as HTMLButtonElement | null;
    function syncFavCount() {
      const count = favsApi()?.list().length ?? 0;
      if (favCountEl) favCountEl.textContent = String(count);
      if (favShareBtn) favShareBtn.disabled = count === 0;
      if (favClearBtn) favClearBtn.disabled = count === 0;
    }
    favShareBtn?.addEventListener('click', () => {
      const ids = (favsApi()?.list() ?? []).slice(0, 100);
      if (!ids.length) return;
      const url = `${location.origin}/?favs=${ids.join(',')}`;
      const label = favShareBtn.querySelector('.btn-label');
      const flash = (text: string) => {
        if (!label) return;
        const orig = label.textContent;
        label.textContent = text;
        setTimeout(() => (label.textContent = orig), 1800);
      };
      navigator.clipboard
        .writeText(url)
        .then(() => flash('Copied!'))
        .catch(() => flash('Copy failed'));
    });

    /* ---------- Data & privacy ---------- */
    function readJson(key: string) {
      try {
        return JSON.parse(localStorage.getItem(key) || 'null');
      } catch (_) {
        return null;
      }
    }
    document.getElementById('exportDataBtn')?.addEventListener('click', () => {
      const data = {
        exportedAt: new Date().toISOString(),
        preferences: prefsApi()?.get() ?? null,
        favorites: favsApi()?.list() ?? [],
        compareIds: readJson('compareIds') ?? [],
        installIds: readJson('installIds') ?? [],
      };
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'perfatlas-data.json';
      a.click();
      URL.revokeObjectURL(url);
    });
    document.getElementById('resetPrefsBtn')?.addEventListener('click', () => prefsApi()?.reset());

    /* ---------- Arm-to-confirm for destructive buttons ---------- */
    function armToConfirm(btn: HTMLButtonElement | null, onConfirm: () => void) {
      if (!btn) return;
      const label = btn.querySelector('.btn-label');
      const orig = label?.textContent ?? '';
      let armed = false;
      let timer: number;
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        if (!armed) {
          armed = true;
          btn.classList.add('armed');
          if (label) label.textContent = 'Click to confirm';
          timer = window.setTimeout(() => {
            armed = false;
            btn.classList.remove('armed');
            if (label) label.textContent = orig;
          }, 3000);
        } else {
          window.clearTimeout(timer);
          armed = false;
          btn.classList.remove('armed');
          if (label) label.textContent = orig;
          onConfirm();
        }
      });
    }
    armToConfirm(favClearBtn, () => favsApi()?.clear());
    armToConfirm(document.getElementById('clearAllBtn') as HTMLButtonElement | null, () => {
      ['favoriteIds', 'compareIds', 'installIds', PREFS_STORAGE_KEY].forEach((k) =>
        localStorage.removeItem(k),
      );
      location.reload();
    });

    /* ---------- React to external changes ---------- */
    document.addEventListener('preferences:update', () => {
      syncThemeTiles();
      syncDefaults();
      flashSaved();
    });
    document.addEventListener('favorites:update', syncFavCount);

    /* ---------- Init ---------- */
    function init() {
      syncThemeTiles();
      syncDefaults();
      syncFavCount();
    }
    // window.__preferences and window.__favorites are created by other modules
    // (PreferencesManager, FavoritesManager) that execute after this page script.
    // Defer to DOMContentLoaded, which fires only once every deferred module has
    // run, so those globals are guaranteed to exist when init reads them.
    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:after-swap', init);
  </script>

  <style>
