{
  "name": "perfatlas",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "tsx scripts/fetchData.mts",
    "dev": "astro dev",
    "prebuild": "tsx scripts/fetchData.mts && tsx scripts/generateOgImages.mts",
    "og:generate": "tsx scripts/generateOgImages.mts",
    "og:rebuild": "tsx scripts/generateOgImages.mts --force",
    "crop:featured": "node scripts/cropBlogFeatured.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "deploy:cloudflare:full": "node scripts/deploy-cloudflare.mjs --deploy",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 100",
    "lint:fix": "eslint . --fix --max-warnings 100",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint:ci && npm run format:check && npm test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.3",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@clerk/astro": "^4.0.16",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.2.4",
    "astro-compress": "^2.4.3",
    "astro-expressive-code": "^0.44.1",
    "astro-pagefind": "^2.0.1",
    "astro-seo": "^1.1.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "linkedom": "^0.18.12",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.60.1",
    "undici": "^8.1.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.123.0"
  }
}
