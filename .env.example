# Clerk Authentication
# Get these from your Clerk Dashboard: https://dashboard.clerk.com
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_test_...

# Optional: Clerk webhook secret for user events
# CLERK_WEBHOOK_SECRET=whsec_...

# GitHub token for API access (to avoid rate limits)
# GITHUB_TOKEN=ghp_...

# Optional: Google Tag Manager container ID (defaults to GTM-W3LV2L26; set "none" to disable)
# PUBLIC_GTM_ID=GTM-W3LV2L26

# Optional: Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Search Console HTML verification meta token
# PUBLIC_GSC_VERIFICATION=your_verification_token

# Optional: IndexNow key for nightly sync search-engine pings
# INDEXNOW_KEY=your_indexnow_key
# INDEXNOW_KEY_LOCATION=https://plugins.jmeter.ai/your_indexnow_key.txt
